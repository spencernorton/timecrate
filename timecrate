cmd_break_glass(){
  local kit="" target="" a
  for a in "$@"; do case "$a" in
    --*) die "unknown break-glass flag: $a";;
    *) if [ -z "$kit" ]; then kit="$a"; else target="$a"; fi;;
  esac; done
  target="${target:-./restore}"
  [ -n "$kit" ] && [ -f "$kit" ] || die "usage: $SELF break-glass <file.tar.zst.gpg> [target-dir]"
  mkdir -p "$target"
  # Extracting a kit with -C / overwrites the running system. That is `restore --to-root`'s job,
  # and it is gated there -- signature verified before a byte is written, and the front-end makes
  # you type the word. Reaching the identical outcome by passing / as a directory would route
  # around that gate completely, and the window hands this argument straight from a folder
  # chooser. The guard lives HERE rather than in the front-end because the front-end is not a
  # security boundary: the engine is what actually runs tar as root, and every caller reaches it.
  #
  # Resolved with `cd`+`pwd -P` after mkdir and immediately before use, so a symlink swapped in
  # between choosing a directory and extracting into it resolves here too. (A swap in the window
  # between this check and tar is still theoretically possible; closing that needs an open fd, and
  # anyone able to win that race already holds the pkexec rights this runs under.)
  local real; real="$(cd "$target" 2>/dev/null && pwd -P || true)"
  [ -n "$real" ] || die "cannot resolve the target directory: $target"
  [ "$real" != "/" ] || die "refusing to extract over / — that is 'restore --to-root', which verifies and asks for confirmation first. Break-glass extracts into a directory for inspection (see BREAK-GLASS.md)."
  target="$real"
  cat <<EOF
Tool-independent recovery (raw gpg + zstd + tar — no timecrate required):
  gpg --status-file st.txt -o kit.tar.zst -d '$kit'
  grep VALIDSIG st.txt        # fpr MUST match the signing key on the escrow sheet — do NOT
                              # extract without it (unsigned = forged or pre-v1.3.0)
  zstd -dc --long=$ZSTD_LONG < kit.tar.zst | sudo tar --numeric-owner --acls --xattrs -xpf - -C '$target'
Running the same steps now (verify-before-extract) →
EOF
  if kit_is_pq "$kit"; then
    cat <<EOF
This kit is PQ-wrapped (TIMECRATE-PQ1 header). Unwrap it FIRST, with the PQ secret key
from the escrow sheet and openssl 3.5+, then run the steps above on inner.gpg:
  head -n1 '$kit' | cut -d' ' -f4 | base64 -d > kem.ct
  openssl pkeyutl -decap -inkey pq-secret.pem -in kem.ct -secret kem.ss
  od -An -tx1 -v kem.ss | tr -d ' \\n' > kem.pass
  tail -n +2 '$kit' | gpg --batch --pinentry-mode loopback --passphrase-file kem.pass -d -o inner.gpg
EOF
  fi
  # temp INSIDE the target dir (disk-backed) — a 2 GB rescue box's /tmp tmpfs can't hold a kit
  local dec; dec="$(mktemp "$target/.timecrate-dec.XXXXXX")"; TC_TMP="$dec"; trap 'rm -f -- "$TC_TMP"' EXIT
  # Report, do not gate: this command exists to be the path that still works when everything else
  # does not, and telling someone "refused" with no route is not that. But it will not extract
  # what it cannot authenticate either -- the printed steps above are the route, and running them
  # by hand is a decision a person makes rather than one this tool makes for them.
  if decrypt_verified "$kit" "$dec" report; then
    zstd -dc --long=$ZSTD_LONG < "$dec" | sudo tar --numeric-owner --acls --xattrs -xpf - -C "$target"
    log "extracted to $target — see $target/$MANIFESTS ($LEGACY_MANIFESTS in a kit made before 3.0.0) for package/dconf replay."
  else
    warn "this archive carries NO verifiable signature."
    warn "Refusing to extract it for you: an unsigned archive is either older than v1.3.0 (2026-07-23) or has been tampered with, and nothing here can tell those apart."
    die "If you know which it is, run the three commands printed above by hand — they need no part of this tool."
  fi
}

# Minimal text-to-PDF (stdlib only): the escrow sheet as printable Courier pages.
escrow_pdf_write(){ # $1 = sheet text, $2 = pdf out
  python3 - "$1" "$2" <<'PYEOF'
import sys, zlib
lines = []
for raw in open(sys.argv[1], encoding="utf-8", errors="replace").read().splitlines():
    while len(raw) > 92:
        lines.append(raw[:92]); raw = raw[92:]
    lines.append(raw)
per = 54
pages = [lines[i:i + per] for i in range(0, len(lines), per)] or [[]]
def esc(s):
    return s.encode("latin-1", "replace").decode("latin-1").replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)")
objs = {}
objs[1] = b"<< /Type /Catalog /Pages 2 0 R >>"
kids = []
contents = []
for i, page in enumerate(pages):
    cnum, pnum = 4 + 2 * i, 5 + 2 * i
    kids.append(b"%d 0 R" % pnum)
    text = ["BT /F1 7.5 Tf 10 TL 36 756 Td"]
    for ln in page:
        text.append("(%s) Tj T*" % esc(ln))
    text.append("ET")
    raw = "\n".join(text).encode("latin-1", "replace")
    objs[cnum] = b"<< /Length %d /Filter /FlateDecode >>\nstream\n" % len(zlib.compress(raw)) + zlib.compress(raw) + b"\nendstream"
    objs[pnum] = ("<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] "
                  "/Resources << /Font << /F1 3 0 R >> >> /Contents %d 0 R >>" % cnum).encode()
objs[2] = b"<< /Type /Pages /Kids [" + b" ".join(kids) + b"] /Count %d >>" % len(pages)
objs[3] = b"<< /Type /Font /Subtype /Type1 /BaseFont /Courier >>"
out = bytearray(b"%PDF-1.4\n")
offsets = {}
for num in sorted(objs):
    offsets[num] = len(out)
    out += b"%d 0 obj\n" % num + objs[num] + b"\nendobj\n"
xref = len(out)
out += b"xref\n0 %d\n0000000000 65535 f \n" % (max(objs) + 1)
for num in range(1, max(objs) + 1):
    out += b"%010d 00000 n \n" % offsets[num]
out += b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (max(objs) + 1, xref)
open(sys.argv[2], "wb").write(bytes(out))
PYEOF
}

cmd_escrow_doc(){
  local out="" fmt=""
  while [ $# -gt 0 ]; do case "$1" in
    --format) fmt="${2:-}"; shift;;
    --format=*) fmt="${1#--format=}";;
    --*) die "unknown escrow-doc flag: $1";;
    *) out="$1";;
  esac; shift; done
  out="${out:-$CONF_DIR/timecrate-ESCROW-DOC.txt}"
  [ -n "$fmt" ] || case "$out" in *.pdf) fmt=pdf;; *) fmt=txt;; esac
  case "$fmt" in txt|pdf) ;; *) die "escrow-doc --format must be txt or pdf";; esac
  [ "$fmt" = pdf ] && case "$out" in *.pdf) ;; *) out="${out%.*}.pdf";; esac
  [ -f "$SECRET_ESCROW" ] || die "no secret key at $SECRET_ESCROW — run '$SELF init' first (or it was hardened away)"
  # the sheet's recovery steps reference the signing key — a sheet without it would instruct
  # a verification that cannot be performed
  [ -f "$SIGNING_PUB" ] || die "signing public key missing ($SIGNING_PUB) — run '$SELF init' first (v1.3.0 sheets must carry it)"
  if [ "$CRYPTO" = hybrid ] && [ ! -f "$PQ_SECRET" ]; then
    die "kit posture is hybrid but no PQ secret at $PQ_SECRET — this sheet could not open a hybrid kit. Run '$SELF pq init', then re-issue the sheet."
  fi
  # the sheet CONTAINS the secret key — writing it anywhere the backup includes would ship the
  # key inside the very kit it decrypts
  local rp inc
  rp="$(realpath -m -- "$out" 2>/dev/null || echo "$out")"
  if [ -r "$INCLUDE_FILE" ]; then
    while read -r inc; do
      case "$rp" in
        "/$inc"/*|"/$inc") die "refusing to write the escrow sheet to $rp — that path is INSIDE the backup include set (/$inc)";;
      esac
    done < <(build_include)
  fi
  local fpr; fpr="$(head -1 "$RECIPIENTS_FILE")"
  local sheet; sheet="$(mktemp)"; chmod 600 "$sheet"
  umask 077
  {
    echo "============ TIMECRATE — KEY ESCROW  (PRINT THIS, STORE OFFLINE) ============"
    echo "Host: $(hostname)    Generated: $(date -Is)    Fingerprint: $fpr"
    echo
    echo "This page decrypts EVERY Timecrate backup. It is NOT stored in the backups."
    echo "Without it, recovery after an OS wipe is IMPOSSIBLE. Keep it in a safe / password"
    echo "manager, separate from the cloud account that holds the backups."
    echo
    echo "--- RECOVER on any machine with gpg + zstd + tar ---"
    echo "  gpg --import <the secret key below>          # decryption"
    echo "  gpg --import <the signing PUBLIC key below>  # authentication"
    echo "  sha256sum -c timecrate-<ts>.tar.zst.gpg.sha256"
    echo "  gpg --status-file st.txt -o kit.tar.zst -d timecrate-<ts>.tar.zst.gpg"
    echo "  grep VALIDSIG st.txt   # MUST list the signing fingerprint printed below —"
    echo "                         # NO VALIDSIG means the kit is forged/tampered: STOP."
    echo "  sudo mkdir -p /restore"
    echo "  zstd -dc --long=$ZSTD_LONG < kit.tar.zst \\"
    echo "    | sudo tar --numeric-owner --acls --xattrs -xpf - -C /restore"
    echo "  (kits made before 3.0.0 are named timemachine-<ts>; the steps are the same)"
    echo "  (full steps: RESTORE.md and BREAK-GLASS.md, https://github.com/spencercnorton/timecrate)"
    if [ -f "$PQ_SECRET" ]; then
      echo "  PQ-wrapped kits (first line starts with TIMECRATE-PQ1) unwrap BEFORE the steps above,"
      echo "  with the PQ secret key printed below and openssl 3.5+:"
      echo "    head -n1 KIT | cut -d' ' -f4 | base64 -d > kem.ct"
      echo "    openssl pkeyutl -decap -inkey pq-secret.pem -in kem.ct -secret kem.ss"
      echo "    od -An -tx1 -v kem.ss | tr -d ' \\n' > kem.pass"
      echo "    tail -n +2 KIT | gpg --batch --pinentry-mode loopback --passphrase-file kem.pass -d -o inner.gpg"
      echo "    then run the gpg/zstd/tar steps above on inner.gpg — it is the signed kit."
    fi
    echo
    echo "--- GPG SECRET KEY (ASCII-armored, decryption) ---"
    cat "$SECRET_ESCROW"
    if [ -f "$SIGNING_PUB" ]; then
      echo
      echo "--- SIGNING PUBLIC KEY (authentication; fpr: $(cat "$SIGNING_FILE" 2>/dev/null || echo '?')) ---"
      cat "$SIGNING_PUB"
    fi
    if [ -f "$PQ_SECRET" ]; then
      echo
      echo "--- PQ SECRET KEY (ML-KEM-1024, PEM — opens the PQ envelope of hybrid kits) ---"
      echo "Fingerprint (SHA-256 of the public key): $(pq_fpr)"
      cat "$PQ_SECRET"
      echo
      echo "--- PQ PUBLIC KEY (ML-KEM-1024, PEM) ---"
      cat "$PQ_PUBLIC"
    fi
  } > "$sheet"
  if [ "$fmt" = pdf ]; then
    escrow_pdf_write "$sheet" "$out" || { rm -f "$sheet"; die "PDF generation failed (python3)"; }
    rm -f "$sheet"
  else
    mv "$sheet" "$out"
  fi
  chmod 600 "$out"
  log "escrow document ($fmt): $out"
  if [ "$fmt" = txt ] && have qrencode; then
    if qrencode -8 -o "${out%.txt}.qr.png" < "$SECRET_ESCROW" 2>/dev/null; then
      log "QR of the key: ${out%.txt}.qr.png (scan to recover the key with no digital copy)"
    else warn "key too large for a single QR — the printed text is authoritative"; fi
  elif [ "$fmt" = txt ]; then warn "install qrencode (apt install qrencode) for a scannable paper QR of the key"; fi
  echo; echo ">> PRINT $out and store it offline. This is your last-resort recovery key. <<"
}

cmd_recovery_drill(){
  # PROVE an escrowed key alone can decrypt a real backup on the remote, in a throwaway keyring.
  local keyfile="${1:-$SECRET_ESCROW}" ts="${2:-}"
  [ -f "$keyfile" ] || die "usage: $SELF recovery-drill [<escrow-key.asc>] [<ts>]  (default key: $SECRET_ESCROW)"
  require_tools cloud
  local t; t="$(disk_workdir drill)" || die "no disk-backed work dir for the drill"; TC_TMP="$t"; trap 'rm -rf -- "$TC_TMP"' EXIT
  export GNUPGHOME="$t/gnupg"; mkdir -p "$GNUPGHOME"; chmod 700 "$GNUPGHOME"
  log "importing ONLY the escrowed key into a throwaway keyring (simulating a wiped OS)…"
  gpg --batch --import "$keyfile" 2>/dev/null || die "could not import key from '$keyfile'"
  # the signing PUBLIC key rides along: the drill proves the escrow can AUTHENTICATE, not just decrypt
  if ! { [ -f "$SIGNING_PUB" ] && gpg --batch --import "$SIGNING_PUB" 2>/dev/null; }; then
    warn "signing public key unavailable ($SIGNING_PUB) — this drill cannot verify the signature"
  fi
  gpgconf --kill gpg-agent 2>/dev/null || true   # fresh agent re-reads the just-imported ECC key (avoids in-process 'Bad secret key')
  # the newest kit of either series, or the one named (a file name or a bare timestamp)
  local name
  if [ -n "$ts" ]; then name="$(resolve_kit "$REMOTE" "$ts")"
  else name="$(rc lsf "$REMOTE" --include "$KIT_GLOB" 2>/dev/null | kit_sort | tail -1)"; fi
  if [ -z "$name" ]; then
    # total wipe is the WORST deletion case — diagnose it, never say "run a backup first"
    # (a fresh backup would rebaseline the anchor and destroy the evidence while the provider's
    # version history keeps expiring)
    if [ -r "$STATE_DIR/expected" ]; then
      die "REMOTE DELETION: 0 kits on $REMOTE but the last backup recorded $(cat "$STATE_DIR/expected" 2>/dev/null) — recover them from the provider's version history NOW, and do NOT run a backup first"
    fi
    die "no kit on $REMOTE to drill against — run a backup first"
  fi
  ts="$(kit_ts "$name")"
  # freshness gate: a green drill on a STALE kit masks silently-stopped backups
  local kd="${ts%_*}" kt="${ts#*_}"; kt="${kt//-/:}"
  local kit_epoch; kit_epoch="$(date -d "$kd $kt" +%s 2>/dev/null || echo 0)"
  if [ "$kit_epoch" -gt 0 ]; then
    local age_days=$(( ( $(date +%s) - kit_epoch ) / 86400 )) max_age="${TIMECRATE_MAX_AGE_DAYS:-3}"
    [ "$age_days" -gt "$max_age" ] && warn "DRILL STALE: newest cloud kit is ${age_days}d old (> ${max_age}d) — backups may have STOPPED"
  fi
  local kit="$t/kit.gpg"; log "fetching kit $ts from $REMOTE…"
  rc copyto "$REMOTE/$name" "$kit"
  [ -s "$kit" ] || die "fetched kit is empty ($kit) — check remote path $REMOTE"
  log "decrypting with ONLY the escrowed key + verifying signature + archive listing…"
  local derr dec st; derr="$(mktemp)"; dec="$t/kit.tar.zst"; st="$t/gpg-status"
  # hybrid kits unwrap through the same seam as every other reader (pq_unwrap dies loud
  # when the PQ secret is absent — the drill must not pretend it proved anything then)
  local inner="$kit"
  if kit_is_pq "$kit"; then inner="$t/kit-inner.gpg"; pq_unwrap "$kit" "$inner"; fi
  set +e
  gpg --batch --no-tty --yes --status-file "$st" -o "$dec" -d "$inner" 2>"$derr"
  local grc=$?
  zstd -dc --long=$ZSTD_LONG < "$dec" 2>/dev/null | tar -tf - >/dev/null 2>&1
  local -a prc=("${PIPESTATUS[@]}")
  set -e
  # signature verdict (verify-before-trust; the --allow-unsigned hatch closed 2026-07-31 and the
  # pre-v1.3.0 transition hatch, window closes ~2026-08-06)
  local sig_ok=0 seen="" expected sig_msg="UNSIGNED kit"
  expected="${TIMECRATE_EXPECT_SIGNER:-}"
  [ -n "$expected" ] || expected="$(cat "$SIGNING_FILE" 2>/dev/null || true)"
  [ -n "$expected" ] || expected="$(gpg --batch --show-keys --with-colons "$SIGNING_PUB" 2>/dev/null | awk -F: '/^fpr/{print $10; exit}' || true)"
  if grep -q '^\[GNUPG:\] VALIDSIG ' "$st" 2>/dev/null; then
    seen="$(awk '/^\[GNUPG:\] VALIDSIG /{print $3; exit}' "$st")"
    if [ -z "$expected" ]; then
      sig_msg="UNPINNED signature $seen (no expected signer configured — not trusted)"
    elif [ "$seen" != "$expected" ]; then
      sig_msg="signature from UNEXPECTED key $seen (expected: $expected)"
    else
      sig_ok=1; sig_msg="signature verified ($seen)"
    fi
  fi
  # ---- remote-wide checks: deletion/rollback detection + verify EVERY kit (not just newest) ----
  local extra_fail="" nkits=0 nver=0 vk
  local -a allkits=()
  mapfile -t allkits < <(rc lsf "$REMOTE" --include "$KIT_GLOB" 2>/dev/null | kit_sort)
  nkits=${#allkits[@]}
  # the remote must still hold what the last backup recorded — an attacker deleting kits (or
  # re-uploading old ones) is invisible to per-kit signature checks, every old kit signs clean
  if [ -r "$STATE_DIR/expected" ]; then
    # NB: a negative subscript into an empty array is FATAL under set -u (':-' does not save
    # it) — guard nkits; an empty listing is itself a deletion signal handled by the count check
    local exp_latest exp_count newest=""
    if [ "$nkits" -gt 0 ]; then newest="${allkits[nkits-1]}"; fi
    exp_latest="$(awk '{print $1}' "$STATE_DIR/expected" || true)"
    exp_count="$(awk '{print $2}' "$STATE_DIR/expected" || true)"
    if [ -n "$exp_latest" ] && [ -n "$newest" ] && kit_older "$newest" "$exp_latest"; then
      extra_fail="REMOTE ROLLBACK: newest remote kit $newest is OLDER than expected $exp_latest"
    fi
    case "$exp_count" in ''|*[^0-9]*) :;; *)
      [ "$nkits" -ge "$exp_count" ] || extra_fail="${extra_fail:+$extra_fail; }REMOTE DELETION: $nkits kits on remote, expected >= $exp_count (recover them from the provider's version history)";;
    esac
  fi
  # sha256 sidecar is only a cheap pre-filter (remote-write attackers forge sidecars too);
  # the signature is the proof. Newest kit was already fully drilled above.
  local badkits=""
  for vk in "${allkits[@]:-}"; do
    [ -n "$vk" ] || continue
    [ "$vk" = "$name" ] && { nver=$((nver+1)); continue; }
    local vf="$t/allv.gpg" vst="$t/allv.st"
    rc copyto "$REMOTE/$vk" "$vf" 2>/dev/null || { badkits="${badkits:+$badkits, }$vk(fetch)"; continue; }
    rc copyto "$REMOTE/$vk.sha256" "$vf.sha256" 2>/dev/null || true
    if [ -s "$vf.sha256" ] && [ "$(sha256sum "$vf" | cut -d' ' -f1)" != "$(awk '{print $1}' "$vf.sha256")" ]; then
      badkits="${badkits:+$badkits, }$vk(sha256)"; rm -f "$vf" "$vf.sha256"; continue
    fi
    local vuse="$vf"
    if kit_is_pq "$vf"; then
      vuse="$t/allv-inner.gpg"
      ( pq_unwrap "$vf" "$vuse" ) 2>/dev/null \
        || { badkits="${badkits:+$badkits, }$vk(pq-unwrap)"; rm -f "$vf" "$vf.sha256"; continue; }
    fi
    gpg --batch --no-tty --yes --status-file "$vst" -o /dev/null -d "$vuse" 2>/dev/null || true
    [ "$vuse" = "$vf" ] || rm -f "$vuse"
    if grep -q '^\[GNUPG:\] VALIDSIG ' "$vst"; then
      if [ -z "$expected" ] || grep -q "^\[GNUPG:\] VALIDSIG $expected" "$vst"; then nver=$((nver+1))
      else badkits="${badkits:+$badkits, }$vk(wrong-signer)"; fi
    elif ! grep -q '^\[GNUPG:\] DECRYPTION_OKAY' "$vst"; then
      badkits="${badkits:+$badkits, }$vk(decrypt)"
    else
      badkits="${badkits:+$badkits, }$vk(unsigned)"
    fi
    rm -f "$vf" "$vf.sha256" "$vst"
  done
  [ -z "$badkits" ] || extra_fail="${extra_fail:+$extra_fail; }KIT VERIFY FAILED: $badkits"
  log "remote sweep: $nkits kits, $nver signature-verified${badkits:+, BAD: $badkits}"
  # the mirror is anchor-checked (newest + count vs what the last backup recorded) — enough to
  # catch a wiped/rotted REMOTE2 that per-backup mirror verification can never see
  if [ -n "$REMOTE2" ] && [ -r "$STATE_DIR/expected2" ]; then
    local l2 n2 e2l e2c
    l2="$(rc lsf "$REMOTE2" --include "$KIT_GLOB" 2>/dev/null | kit_sort || true)"
    n2="$(printf '%s\n' "$l2" | grep -c . || true)"
    e2l="$(awk '{print $1}' "$STATE_DIR/expected2" || true)"
    e2c="$(awk '{print $2}' "$STATE_DIR/expected2" || true)"
    if [ -n "$e2l" ] && ! printf '%s\n' "$l2" | grep -qFx "$e2l"; then
      extra_fail="${extra_fail:+$extra_fail; }REMOTE2 DEGRADED: recorded newest $e2l missing from $REMOTE2"
    fi
    case "$e2c" in ''|*[^0-9]*) :;; *)
      [ "${n2:-0}" -ge "$e2c" ] || extra_fail="${extra_fail:+$extra_fail; }REMOTE2 DELETION: ${n2:-0} kits, expected >= $e2c";;
    esac
    log "remote2 anchor check: ${n2:-0} kits on $REMOTE2 (expected >= ${e2c:-?})"
  fi

  mkdir -p "$STATE_DIR" 2>/dev/null || true
  if [ "$grc" = 0 ] && [ "${prc[0]:-9}" = 0 ] && [ "${prc[1]:-9}" = 0 ] \
     && [ -z "$extra_fail" ] \
     && [ "$sig_ok" = 1 ]; then
    rm -f "$derr"; write_escrow_confirmed 2>/dev/null || true
    # machine-readable result: the status pill (CLI + GUI) reads this, not the journal
    printf '%s drill PASSED %s\n' "$(date -Is)" "$ts" >> "$STATE_DIR/log" 2>/dev/null || true
    write_status
    log "RECOVERY DRILL PASSED — the escrowed key alone decrypts AND authenticates a real backup ($sig_msg)."
  else
    printf '%s drill FAILED %s\n' "$(date -Is)" "$ts" >> "$STATE_DIR/log" 2>/dev/null || true
    write_status
    warn "stage exits: gpg=$grc zstd=${prc[0]:-?} tar=${prc[1]:-?}; sig: $sig_msg; gpg: $(tail -2 "$derr" | tr '\n' ' ')"
    [ -z "$extra_fail" ] || warn "remote checks: $extra_fail"
    rm -f "$derr"; die "RECOVERY DRILL FAILED — ${extra_fail:-kit $ts did not decrypt+verify with key '$keyfile'}. FIX ESCROW/SIGNING/REMOTE BEFORE TRUSTING IT."
  fi
}

cmd_escrow_confirm(){ mkdir -p "$CONF_DIR"; write_escrow_confirmed; write_status; log "escrow marked confirmed."; }

# Write one setting into the per-user config. Mirrors what the settings window does, because the
# engine now has commands that change configuration too. Atomic, shell-quoted (this file is
# sourced), and keeps exactly one .bak -- the documented rollback in the plan's migration rules.
write_user_setting(){
  local name="$1" value="$2"
  mkdir -p "$(dirname "$USER_CONF")" 2>/dev/null || true
  TC_W_PATH="$USER_CONF" TC_W_NAME="$name" TC_W_VALUE="$value" python3 -c '
import os, re, shlex
path, name, value = os.environ["TC_W_PATH"], os.environ["TC_W_NAME"], os.environ["TC_W_VALUE"]
try:
    lines = open(path, encoding="utf-8").read().splitlines()
except FileNotFoundError:
    lines = ["# Timecrate - per-user settings.",
             "# Overrides the system config; the environment still wins over both.",
             "# `timecrate config` shows what is actually in effect."]
else:
    try:                                     # one .bak, overwritten each time: the rollback path
        mode = os.stat(path).st_mode & 0o777
        fd = os.open(path + ".bak", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as bak:
            bak.write("\n".join(lines) + "\n")
    except OSError:
        pass
entry = "%s=%s" % (name, shlex.quote(value))
pat = re.compile(r"^\s*(?:export\s+)?%s=" % re.escape(name))
for i, line in enumerate(lines):
    if pat.match(line):
        lines[i] = entry
        break
else:
    lines.append(entry)
# Inherit the existing mode rather than the umask: nothing guarantees this file stays free of
# sensitive settings just because the current version of it happens to be.
try:
    mode = os.stat(path).st_mode & 0o777
except OSError:
    mode = 0o600
tmp = path + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
with os.fdopen(fd, "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines).rstrip() + "\n")
os.chmod(tmp, mode)
os.replace(tmp, path)
' || die "could not write $USER_CONF"
}

# ============================ history and alerting ============================
# Two questions this tool could not answer about itself: what has it been doing, and would it
# actually reach you if it stopped.

# The state log is append-only and has grown fields over time:
#   <iso> ok    <ts> <file> [bytes] [seconds]     -- pre-1.9.0 lines have neither trailing field
#   <iso> drill <PASSED|FAILED> <ts>
# Readers must tolerate both shapes, so parse by record type and never by field count.
cmd_history(){
  local json=0 limit=20
  while [ $# -gt 0 ]; do case "$1" in
    --json) json=1;;
    -n) limit="${2:-20}"; shift;;
    --*) die "unknown history flag: $1";;
  esac; shift; done
  case "$limit" in ''|*[^0-9]*) die "-n takes a number";; esac
  [ -r "$STATE_DIR/log" ] || { [ "$json" = 1 ] && echo '[]' || log "no history yet ($STATE_DIR/log)"; return 0; }

  TC_H_LOG="$STATE_DIR/log" TC_H_LIMIT="$limit" TC_H_JSON="$json" python3 -c '
import json, os, sys
rows = []
for line in open(os.environ["TC_H_LOG"], encoding="utf-8", errors="replace"):
    f = line.split()
    if len(f) < 3:
        continue
    when, kind = f[0], f[1]
    if kind == "drill":
        rows.append({"when": when, "kind": "drill", "result": f[2],
                     "bytes": "", "seconds": "", "name": f[3] if len(f) > 3 else ""})
    elif kind in ("ok", "fail"):
        # bytes/seconds are appended fields: absent on anything written before 1.9.0, and absent
        # is UNKNOWN rather than zero.
        rows.append({"when": when, "kind": "backup", "result": kind,
                     "name": f[3] if len(f) > 3 else "",
                     "bytes": f[4] if len(f) > 4 and f[4].isdigit() else "",
                     "seconds": f[5] if len(f) > 5 and f[5].isdigit() else ""})
rows = rows[-int(os.environ["TC_H_LIMIT"]):]
if os.environ["TC_H_JSON"] == "1":
    print(json.dumps(rows)); sys.exit(0)
def hb(n):
    if not n: return "size unknown"
    n = float(n)
    for u in ("B","KB","MB","GB","TB"):
        if n < 1024 or u == "TB": return "%.1f %s" % (n, u)
        n /= 1024
for r in reversed(rows):
    if r["kind"] == "drill":
        print("  %s  drill %s" % (r["when"][:19], r["result"]))
    else:
        dur = ("%ss" % r["seconds"]) if r["seconds"] else "duration unknown"
        print("  %s  backup %-4s %-12s %s" % (r["when"][:19], r["result"], hb(r["bytes"]), dur))
'
}

# Whether a failure would actually reach anyone. The key lives in the root-only secrets file, so
# an unprivileged run genuinely cannot tell -- and saying "not configured" in that case would be
# the same lie as reporting an unreadable keyring as an absent one.
cmd_alerts(){
  local sub="${1:-status}"
  case "$sub" in
    status|--json) ;;
    test) need_root "alerts test"; alerts_test; return $?;;
    *) die "unknown alerts subcommand '$sub' — expected status or test";;
  esac
  local json=0; [ "$sub" = --json ] && json=1
  [ "${2:-}" = --json ] && json=1

  # The command may be set in the root-only secrets file. An unprivileged run that cannot read it
  # cannot know, and saying "not configured" then would be the same lie as reporting an unreadable
  # keyring as an absent one.
  local readable=true configured=""
  if [ -n "$ALERT_CMD" ]; then configured=true
  elif [ -e "$SECRET_ENV" ] && [ ! -r "$SECRET_ENV" ]; then readable=false
  else configured=false; fi

  if [ "$json" = 1 ]; then
    TC_A_READABLE="$readable" TC_A_CONF="$configured" TC_A_CMD="$ALERT_CMD" \
    TC_A_SEV="$ALERT_SEVERITY" TC_A_FILE="$SECRET_ENV" \
    python3 -c '
import json, os
e = os.environ.get
print(json.dumps({
  "readable": e("TC_A_READABLE") != "false",
  # "" means could not tell, which is NOT the same as false
  "configured": {"true": True, "false": False}.get(e("TC_A_CONF",""), ""),
  # what a FAILURE runs, and at what severity
  "command": e("TC_A_CMD",""), "severity": e("TC_A_SEV",""),
  "secrets_file": e("TC_A_FILE",""),
}))'
    return 0
  fi

  echo "Failure alerts"
  if [ "$readable" = false ]; then
    printf '  status       CANNOT TELL — %s is root-only, and TIMECRATE_ALERT_CMD may be set there.\n' "$SECRET_ENV"
    printf '               Check with:  sudo %s alerts\n' "$SELF"
  elif [ "$configured" = true ]; then
    printf '  status       configured — a failure runs %s (severity %s)\n' "$ALERT_CMD" "$ALERT_SEVERITY"
    [ -x "$ALERT_CMD" ] || printf '  WARNING      %s is not an executable file, so nothing would be delivered\n' "$ALERT_CMD"
    printf '  test it      sudo %s alerts test   — sends a real alert, so you find out now\n' "$SELF"
  else
    printf '  status       journal only — a failed backup or drill is written to the system journal and\n'
    printf '               sent nowhere else. Set TIMECRATE_ALERT_CMD (ALERTS in timecrate(1)).\n'
  fi
}

alerts_test(){
  local runner="" d
  for d in "$HERE/deploy" /usr/libexec/timecrate; do
    [ -x "$d/alert.sh" ] && { runner="$d/alert.sh"; break; }
  done
  [ -n "$runner" ] || die "alert.sh not found — looked in $HERE/deploy and /usr/libexec/timecrate"
  [ -n "$ALERT_CMD" ] || die "TIMECRATE_ALERT_CMD is not set, so a failure is written to the system journal and sent nowhere else. Set it in $SYSTEM_CONF or $SECRET_ENV (ALERTS in timecrate(1))."
  log "sending a test alert down the same path a failure would take…"
  # Deliberately the real runner, the real command and a failure's severity: an alert path that is
  # only ever exercised by a real failure is one nobody knows is broken, and a test sent at a
  # friendlier severity would prove a path that failures do not take.
  printf 'Test alert from Timecrate on %s. Sent down the same path and at the same severity as a failed backup or drill, so the path that matters is the one being proved. Nothing is actually wrong.\n' "$(hostname)" \
    | TIMECRATE_ALERT_CMD="$ALERT_CMD" "$runner" "$ALERT_SEVERITY" "Timecrate alert test (not a real failure)" test \
    || die "the alert did NOT go through — a real failure would not reach you either"
  log "delivered. If that did not arrive, the alert path is broken even though this said it sent."
}

# ============================ include / exclude lists ============================
# The two files that decide what a kit contains. They live in /etc and are root-owned, which is
# why the front-end could only ever OPEN them: it ran as the user, so "Edit" led to a read-only
# buffer and a saved-file error. Editing them is a privileged operation, so it belongs here,
# behind the same pkexec binary as backup and restore.

paths_file(){
  case "$1" in
    include) printf '%s' "$INCLUDE_FILE";;
    exclude) printf '%s' "$EXCLUDE_FILE";;
    *) die "expected 'include' or 'exclude', got '$1'";;
  esac
}

# Entries are stored relative to / (tar --files-from runs with -C /), except ~/ which the engine
# expands against the CONFIGURED user's home so a shipped list survives a different username.
# Normalising here means the front-end can hand over whatever the file chooser produced.
paths_normalise(){
  local p="$1"
  # These are case PATTERNS matching a literal "~/" prefix, not an expansion: the engine expands
  # ~/ itself against the configured user home at build time. The directive has to sit directly
  # against the command it covers, with no comment line in between, or it does not apply.
  # shellcheck disable=SC2088
  case "$p" in
    "~/"*) printf '%s' "$p"; return 0;;
    "$USER_HOME"/*) printf '~/%s' "${p#"$USER_HOME"/}"; return 0;;
    /*) printf '%s' "${p#/}"; return 0;;
    *) printf '%s' "$p"; return 0;;
  esac
}

# What is covered, what is skipped, and — the part nothing else answers — what is neither.
#
# The include list is an ALLOWLIST: anything not named is silently absent from every kit, and until
# this command existed nothing said so. A real audit found /usr/local missing entirely (software
# that comes from no package, so the dpkg replay cannot recreate it) and thirty-plus uncovered
# settings directories, on a box whose backups had been reporting success nightly for weeks.
#
# It classifies against build_include/build_exclude — the SAME functions the backup feeds to tar —
# rather than re-reading the files, so this view and the kit cannot drift apart.
#
#   included  the path, or an ancestor of it, is in the include list
#   partial   only part of this tree is included (an include entry sits underneath it)
#   excluded  an exclude rule matches, and the rule is named
#   UNLISTED  nothing matches: it is silently absent from every kit
cov_classify(){   # <relpath> ; echoes "state<TAB>rule"
  local p="$1" inc exc comp
  while IFS= read -r exc; do
    [ -n "$exc" ] || continue
    # Unquoted on the right of `case` ON PURPOSE: tar's --exclude patterns are globs, so `*.pyc`
    # and `_tmp_*` have to match here too. Quoting them made this classifier literal-only, which
    # meant coverage could call a file included that the backup then excluded — the one thing this
    # command promises cannot happen.
    # shellcheck disable=SC2254
    case "$p" in $exc|$exc/*) printf 'excluded\t%s\n' "$exc"; return;; esac
    # A pattern without a slash matches ANY path component, which is how tar applies it.
    case "$exc" in
      */*) ;;
      *) local IFS_SAVE="$IFS"; IFS=/
         for comp in $p; do
           # shellcheck disable=SC2254
           case "$comp" in $exc) IFS="$IFS_SAVE"; printf 'excluded\t%s\n' "$exc"; return;; esac
         done
         IFS="$IFS_SAVE" ;;
    esac
  done <<< "$COV_EXC"
  while IFS= read -r inc; do
    [ -n "$inc" ] || continue
    case "$p" in "$inc"|"$inc"/*) printf 'included\t%s\n' "$inc"; return;; esac
  done <<< "$COV_INC"
  while IFS= read -r inc; do
    [ -n "$inc" ] || continue
    case "$inc" in "$p"/*) printf 'partial\t%s\n' "$inc"; return;; esac
  done <<< "$COV_INC"
  printf 'UNLISTED\t-\n'
}

cmd_coverage(){
  local json=0 sizes=1 warn_mb="${TIMECRATE_COVERAGE_WARN_MB:-100}" roots=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)     json=1 ;;
      --no-size)  sizes=0 ;;
      --warn-mb)  shift; warn_mb="${1:-100}" ;;
      --root)     shift; roots="$roots ${1:-}" ;;
      -h|--help)  echo "usage: $SELF coverage [--root PATH]... [--json] [--no-size] [--warn-mb N]"; return 0 ;;
      *) die "unknown coverage option '$1'" ;;
    esac
    shift
  done
  # Default roots are where the gaps actually hide: the top of the filesystem, the top of the
  # backed-up user's home, and inside .config — a hand-picked settings list rots exactly there.
  [ -n "$roots" ] || roots="/ $USER_HOME $USER_HOME/.config"
  # Named explicitly rather than left to `set -e`. Without this a missing list aborted the command
  # with NO output at all — a silent death, which is precisely the behaviour this tool exists to
  # stamp out, and it would have looked like "nothing is uncovered".
  [ -r "$INCLUDE_FILE" ] || die "include list missing/unreadable: $INCLUDE_FILE"
  [ -r "$EXCLUDE_FILE" ] || die "exclude list missing/unreadable: $EXCLUDE_FILE"
  # `|| true` is load-bearing. build_exclude ends in a `[ -n "$p" ] && printf` loop, so it returns
  # NON-ZERO whenever the last of CONF_DIR/RCLONE_CONF/STAGING_ROOT happens to be empty — and under
  # `set -e` that killed this command with no output and no message at all. Their OUTPUT is the
  # contract here, not their exit status; the readable-file checks above are what actually guard it.
  COV_INC="$(build_include || true)"; COV_EXC="$(build_exclude || true)"
  local rows="" root entry rel st rule kb
  for root in $roots; do
    [ -d "$root" ] || continue
    for entry in "$root"/* "$root"/.[!.]*; do
      [ -e "$entry" ] || continue
      rel="${entry#/}"
      IFS=$'\t' read -r st rule <<< "$(cov_classify "$rel")"
      kb=0
      # `|| true` and the fallback are load-bearing: du exits non-zero on any unreadable
      # subdirectory, and under `set -e` that ended the whole report early — which would have
      # looked exactly like "there is nothing else uncovered".
      [ "$sizes" = 1 ] && { kb="$(du -sxk "$entry" 2>/dev/null | tail -1 | cut -f1 || true)"; kb="${kb:-0}"; }
      rows="$rows$st\t${kb:-0}\t$rel\t$rule\n"
    done
  done
  if [ "$json" = 1 ]; then
    printf '%b' "$rows" | TC_WARN_MB="$warn_mb" python3 -c '
import json, os, sys
warn = int(os.environ.get("TC_WARN_MB", "100"))
out = []
for line in sys.stdin.read().splitlines():
    if not line.strip(): continue
    st, kb, path, rule = (line.split("\t") + ["", "", "", ""])[:4]
    out.append({"state": st, "kb": int(kb or 0), "path": path, "rule": rule})
un = [r for r in out if r["state"] == "UNLISTED" and r["kb"] >= warn * 1024]
print(json.dumps({"warn_mb": warn, "entries": sorted(out, key=lambda r: -r["kb"]),
                  "unlisted_over_warn": sorted(un, key=lambda r: -r["kb"])}, indent=1))'
    return 0
  fi
  # Largest first, and UNLISTED first within that: the actionable rows are the ones nothing covers.
  # LC_ALL=C: the worst-first ordering relies on comparing state names, and under another
  # collation "UNLISTED" does not necessarily sort where this expects — the most important rows
  # would quietly stop being the first ones you read.
  printf '%b' "$rows" | LC_ALL=C sort -t"$(printf '\t')" -k1,1r -k2,2nr | awk -F'\t' -v warn="$warn_mb" '
    function human(k){ return k>=1048576 ? sprintf("%.1fG", k/1048576) : (k>=1024 ? sprintf("%dM", k/1024) : sprintf("%dK", k)) }
    { printf "  %-9s %8s  %-52s %s\n", $1, human($2), $3, ($4=="-"?"":$4)
      if ($1=="UNLISTED" && $2/1024 >= warn) big++ }
    END { if (big) printf "\n  %d unlisted director%s over %sMB — nothing in any kit covers them.\n", big, (big==1?"y":"ies"), warn }'
}

cmd_paths(){
  local which="${1:-}" action="${2:-list}" arg="${3:-}"
  [ -n "$which" ] || die "usage: $SELF paths <include|exclude> [list|add <path>|remove <path>]"
  local file; file="$(paths_file "$which")"

  case "$action" in
    list)
      [ -r "$file" ] || die "cannot read $file"
      grep -vE '^[[:space:]]*(#|$)' "$file" || true
      return 0;;
    add|remove) ;;
    *) die "unknown paths action '$action' — expected list, add or remove";;
  esac

  need_root paths
  [ -n "$arg" ] || die "usage: $SELF paths $which $action <path>"
  # A newline would inject a second entry; .. would let a relative entry climb out of the tree it
  # is meant to describe. Both arrive from a graphical file chooser, so neither is hypothetical.
  # Control bytes only. The first cut rejected everything outside printable ASCII, which refused
  # perfectly ordinary filenames -- /home/user/Résumé is not an attack, and tar handles it fine.
  case "$arg" in
    *[$'\001'-$'\037'$'\177']*) die "path contains a control character or newline";;
    *..*) die "path may not contain '..'";;
  esac
  local entry; entry="$(paths_normalise "$arg")"
  [ -n "$entry" ] || die "empty path"
  [ -w "$file" ] || die "cannot write $file"

  # add/remove is read-whole-file, write-temp, rename. Two of those interleaved means the second
  # rename discards the first edit, with nothing to show for it. Lock a companion file rather
  # than the list itself: the rename replaces the list's inode, so a lock held on it would not be
  # seen by whoever opens the new one.
  exec 9>>"${file}.lock" || die "cannot create a lock beside $file"
  flock -x 9 || die "could not lock $file"

  local tmp; tmp="$(mktemp "${file}.XXXXXX")"
  # Preserve the file's mode: these are conffiles and a 644 list should not come back 600 (or
  # worse, world-writable) because of whatever umask the caller happened to have.
  chmod --reference="$file" "$tmp" 2>/dev/null || chmod 644 "$tmp"
  if [ "$action" = add ]; then
    if grep -qxF "$entry" "$file"; then
      rm -f "$tmp"; exec 9>&-; log "$entry is already in the $which list"; return 0
    fi
    cat "$file" > "$tmp"
    printf '%s\n' "$entry" >> "$tmp"
    mv -f "$tmp" "$file"
    log "added to $which: $entry"
  else
    grep -qxF "$entry" "$file" || { rm -f "$tmp"; exec 9>&-; die "$entry is not in the $which list"; }
    grep -vxF "$entry" "$file" > "$tmp" || true
    mv -f "$tmp" "$file"
    log "removed from $which: $entry"
  fi
  # Say what it costs, because the size rails are what turn a bad edit into a refused backup at
  # 03:00 rather than a silently wrong one.
  exec 9>&-
  log "run '$SELF backup --dry-run' to see what the kit would contain now."
}

# ============================ remote management ============================
# Everything about WHERE the backups go. Unprivileged: the rclone config belongs to the configured
# user, same reasoning as the keyring.
#
# SECRETS NEVER LEAVE THIS SECTION. `rclone config show`/`dump` print the OAuth token in full, so
# nothing here shells out to them for display -- config is parsed and only whitelisted fields are
# emitted. A token in the activity log is a token in the backup, in the journal, and in CI.

remote_name(){ printf '%s' "${REMOTE%%:*}"; }

# Whitelisted fields only, straight out of rclone's own JSON. Never the token itself -- only
# whether one exists and when it expires.
remote_conf_facts(){
  local name; name="$(remote_name)"
  [ -n "$name" ] || return 0
  rc config dump 2>/dev/null | TC_RNAME="${TC_RNAME:-$name}" python3 -c '
import json, os, sys
try:
    conf = json.load(sys.stdin)
except Exception:
    sys.exit(0)
r = conf.get(os.environ["TC_RNAME"]) or {}
tok = r.get("token") or ""
expiry = ""
if tok:
    try:
        expiry = (json.loads(tok) or {}).get("expiry", "") or ""
    except Exception:
        expiry = "unparsable"
# type, whether a token exists at all, and its expiry. Nothing else.
print(json.dumps({"type": r.get("type", ""), "has_token": bool(tok), "token_expiry": expiry}))
' 2>/dev/null || true
}

cmd_remote(){
  local sub="${1:-status}"; [ $# -gt 0 ] && shift
  case "$sub" in
    status)     remote_status "$@";;
    connect)    remote_connect "$@";;
    test)       remote_test "$@";;
    browse)     remote_browse "$@";;
    mkdir)      remote_mkdir "$@";;
    set-path)   remote_set_path "$@";;
    disconnect) remote_disconnect "$@";;
    *) die "unknown remote subcommand '$sub' — expected status, connect, test, browse, mkdir, set-path or disconnect";;
  esac
}

remote_status(){
  local json=0; [ "${1:-}" = --json ] && json=1
  # deliberately NOT require_tools cloud: "there is no remote" is a status this command has to be
  # able to report, not a reason for it to refuse to run
  have rclone || die "rclone is not installed"
  local name facts reachable=false kits="" last=""
  name="$(remote_name)"
  facts="$(remote_conf_facts)"
  local listing lrc=0
  listing="$(rc lsf "$REMOTE" --include "$KIT_GLOB" 2>/dev/null)" || lrc=$?
  if [ "$lrc" = 0 ]; then
    reachable=true
    kits="$(printf '%s' "$listing" | grep -c . || true)"
  fi
  last="$(grep ' ok ' "$STATE_DIR/log" 2>/dev/null | tail -1 | awk '{print $1}' || true)"
  local acct=""
  acct="$(rc config userinfo "$name:" 2>/dev/null | awk -F': *' '/[Ee]mail/{print $2; exit}' || true)"
  # Quota belongs to the whole remote, not the backup folder — same call `status` makes, so the
  # two views cannot disagree. Leaving it out entirely made the front-end say "not reported by
  # this provider" about a provider that reports it perfectly well.
  local about=""
  [ -n "$REMOTE" ] && { about="$(rc about "${REMOTE%%:*}:" --json 2>/dev/null)" || about=""; }

  local dfacts dacct=""
  dfacts="$(drive_conf_facts)"; [ -n "$dfacts" ] || dfacts='{}'
  dacct="$(rc config userinfo "$DRIVE_REMOTE:" 2>/dev/null | awk -F': *' '/[Ee]mail/{print $2; exit}' || true)"
  if [ "$json" = 1 ]; then
    # NOT "${facts:-{}}": bash ends the expansion at the first } inside the default, so that
    # appends a stray brace and the JSON silently fails to parse -- which showed up as the text
    # output naming the backend while --json swore nothing was configured.
    [ -n "$facts" ] || facts='{}'
    TC_R_REMOTE="$REMOTE" TC_R_NAME="$name" TC_R_FACTS="$facts" TC_R_REACH="$reachable" \
    TC_R_KITS="$kits" TC_R_LAST="$last" TC_R_ACCT="$acct" TC_R_CONF="$RCLONE_CONF" \
    TC_R_ABOUT="$about" TC_R_DFACTS="$dfacts" TC_R_DNAME="$DRIVE_REMOTE" TC_R_DCONF="$DRIVE_CONF" \
    TC_R_DACCT="$dacct" \
    python3 -c '
import json, os
e = os.environ.get
try: facts = json.loads(e("TC_R_FACTS") or "{}")
except Exception: facts = {}
try: dfacts = json.loads(e("TC_R_DFACTS") or "{}")
except Exception: dfacts = {}
# a backend that cannot answer `about` is not a backend at quota zero
quota = {"remote_quota_used": "", "remote_quota_total": ""}
try:
    a = json.loads(e("TC_R_ABOUT") or "{}")
    if a.get("total") is not None: quota["remote_quota_total"] = str(a["total"])
    if a.get("used") is not None:  quota["remote_quota_used"]  = str(a["used"])
except Exception:
    pass
print(json.dumps({
  "remote": e("TC_R_REMOTE",""), "name": e("TC_R_NAME",""),
  "type": facts.get("type",""), "configured": bool(facts.get("type")),
  "has_token": bool(facts.get("has_token")), "token_expiry": facts.get("token_expiry",""),
  "account": e("TC_R_ACCT",""),
  # reachable is a fact about right now; "" kits means we could not ask, never zero
  "reachable": e("TC_R_REACH") == "true", "kits": e("TC_R_KITS",""),
  "last_backup": e("TC_R_LAST",""), "rclone_config": e("TC_R_CONF",""),
  "drive_remote": e("TC_R_DNAME",""), "drive_config": e("TC_R_DCONF",""),
  "drive_configured": bool(dfacts.get("type")), "drive_signed_in": bool(dfacts.get("has_token")),
  "drive_account": e("TC_R_DACCT",""),
  **quota,
}))'
    return 0
  fi

  echo "Remote"
  if [ -z "$REMOTE" ]; then
    printf '  path         NONE — this machine is not pointed at a remote.\n'
    printf '               Set one with:  %s remote set-path <remote:path>\n' "$SELF"
    return 0
  fi
  printf '  path         %s\n' "$REMOTE"
  local rtype; rtype="$(printf '%s' "${facts:-}" | python3 -c 'import json,sys
try: print((json.load(sys.stdin) or {}).get("type",""))
except Exception: print("")' 2>/dev/null || true)"
  # the Drive remote lives in its own config: a status that only reads the main one
  # reports NOT CONFIGURED for a signed-in, reachable Drive — the split-brain this
  # command exists to end. Consult the drive facts when the path names that remote.
  if [ -z "$rtype" ] && [ "$name" = "$DRIVE_REMOTE" ]; then
    rtype="$(printf '%s' "${dfacts:-}" | python3 -c 'import json,sys
try: print((json.load(sys.stdin) or {}).get("type",""))
except Exception: print("")' 2>/dev/null || true)"
  fi
  if [ -n "$rtype" ]; then
    printf '  backend      %s (rclone remote "%s")\n' "$rtype" "$name"
  else
    printf '  backend      NOT CONFIGURED — there is no rclone remote called "%s".\n' "$name"
    printf '               Connect one with:  %s remote connect\n' "$SELF"
  fi
  [ -n "$acct" ] && printf '  account      %s\n' "$acct"
  local exp; exp="$(printf '%s' "${facts:-}" | python3 -c 'import json,sys
try: print((json.load(sys.stdin) or {}).get("token_expiry",""))
except Exception: print("")' 2>/dev/null || true)"
  [ -n "$exp" ] && printf '  token        renews automatically; current one expires %s\n' "$exp"
  if [ "$reachable" = true ]; then
    printf '  reachable    yes — %s backup(s) at this path\n' "${kits:-0}"
  else
    printf '  reachable    NO — could not list %s. Run '\''%s remote test'\'' for the reason.\n' "$REMOTE" "$SELF"
  fi
  if [ -n "$about" ]; then
    printf '%s' "$about" | python3 -c '
import json, sys
def hb(n):
    n = float(n)
    for u in ("B","KB","MB","GB","TB","PB"):
        if n < 1024 or u == "PB": return "%.1f %s" % (n, u)
        n /= 1024
try:
    a = json.load(sys.stdin)
    if a.get("total") is not None:
        print("  space        %s of %s used" % (hb(a.get("used", 0)), hb(a["total"])))
except Exception:
    pass' 2>/dev/null || true
  fi
  [ -n "$last" ] && printf '  last backup  %s\n' "$last"
  if [ "$name" = "$DRIVE_REMOTE" ]; then
    printf '  config       %s (Drive sign-in config)\n' "$DRIVE_CONF"
  else
    printf '  config       %s\n' "$RCLONE_CONF"
  fi
}

# Whitelisted facts about the DRIVE remote, from its own config (same parser, other file).
drive_conf_facts(){ TC_RC_CONF="$DRIVE_CONF" TC_RNAME="$DRIVE_REMOTE" remote_conf_facts; }

remote_connect(){
  local provider=dropbox force=0
  while [ $# -gt 0 ]; do case "$1" in
    --provider) provider="${2:-dropbox}"; shift;;
    --force|--reauthorize) force=1;;
    --*) die "unknown connect flag: $1";;
  esac; shift; done
  have rclone || die "rclone is not installed"
  local -a headless=()
  # Google Drive signs in as its own remote in its own config, independent of whatever
  # TIMECRATE_REMOTE currently names — that independence is the point of the feature.
  if [ "$provider" = drive ]; then
    local name="$DRIVE_REMOTE" existing
    existing="$(drive_conf_facts)"
    if printf '%s' "$existing" | grep -q '"type": *"[^"]'; then
      [ "$force" = 1 ] || die "an rclone remote called '$name' already exists. Pass --reauthorize to replace its credentials (the backups themselves are untouched)."
    fi
    if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
      log "no graphical session here, so the browser step has to happen elsewhere:"
      log "  1. on a machine with a browser:  rclone authorize \"drive\""
      log "  2. paste the token it prints when this command asks for it"
      headless=(config_is_local=false)
    fi
    umask 077; mkdir -p "$CONF_DIR"
    log "starting the Google Drive authorisation for rclone remote '$name' (a browser opens)…"
    TC_RC_CONF="$DRIVE_CONF" rc config create "$name" drive "${headless[@]}" \
      || die "rclone could not create the Drive remote — sign-in was not completed"
    [ -f "$DRIVE_CONF" ] && chmod 600 "$DRIVE_CONF" 2>/dev/null || true
    rc lsf "$name:" >/dev/null 2>&1 || die "signed in, but Drive does not answer yet — check the account and run '$SELF remote status'"
    log "signed in to Google Drive as remote '$name'."
    log "  pick the backup folder:  $SELF remote browse $name:   then   $SELF remote set-path $name:<folder>"
    return 0
  fi
  local name; name="$(remote_name)"
  [ -n "$name" ] || die "no remote configured to connect — set TIMECRATE_REMOTE first, e.g. dropbox:Backup/TIMECRATE"

  local existing; existing="$(remote_conf_facts)"
  if printf '%s' "$existing" | grep -q '"type": *"[^"]'; then
    [ "$force" = 1 ] || die "an rclone remote called '$name' already exists. Pass --reauthorize to replace its credentials (the backups themselves are untouched)."
  fi

  # rclone's OAuth flow wants a browser on this machine. Over SSH there is none, and the failure
  # is a hang rather than a message, so say the other half of the dance up front.
  if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    log "no graphical session here, so the browser step has to happen elsewhere:"
    log "  1. on a machine with a browser:  rclone authorize \"$provider\""
    log "  2. paste the token it prints when this command asks for it"
    # config_is_local=false is what actually switches rclone off the local-browser flow. Printing
    # the instructions without it left the advertised headless path doing local auto-config --
    # hanging in exactly the environment the message says it supports.
    headless=(config_is_local=false)
  fi
  log "starting the $provider authorisation for rclone remote '$name'…"
  rc config create "$name" "$provider" "${headless[@]}" || die "rclone could not create the remote"
  [ -f "$RCLONE_CONF" ] && chmod 600 "$RCLONE_CONF" 2>/dev/null || true
  log "connected. Checking it works…"
  remote_test
}

remote_test(){
  require_tools cloud
  local name; name="$(remote_name)"
  local out rcode=0
  out="$(rc lsf "$REMOTE" 2>&1)" || rcode=$?
  if [ "$rcode" = 0 ]; then
    log "list OK — $REMOTE is readable"
  else
    # rclone's exit codes distinguish "not there" from "cannot get in"; the message carries the
    # rest. Reporting all of these as "remote unreachable" is what sends people to check their
    # network when the token has simply expired.
    case "$rcode:$out" in
      3:*|*"directory not found"*)
        die "the path $REMOTE does not exist yet on '$name'. Create it with '$SELF remote mkdir $REMOTE', or point somewhere else with '$SELF remote set-path'.";;
      *401*|*"invalid_grant"*|*"authentication"*|*"token"*|*"expired"*)
        die "'$name' will not authenticate — its token is rejected or expired. Reconnect with '$SELF remote connect --reauthorize'.";;
      *"didn't find section"*|*"section not found"*)
        die "there is no rclone remote called '$name'. Create it with '$SELF remote connect'.";;
      *)
        die "cannot reach $REMOTE (rclone exit $rcode): $(printf '%s' "$out" | tail -1)";;
    esac
  fi

  # A remote that lists but will not accept a write is a backup that fails at 03:00, not now.
  local probe=".timecrate-write-probe-$$"
  if printf 'timecrate write probe\n' | rc rcat "$REMOTE/$probe" 2>/dev/null; then
    rc deletefile "$REMOTE/$probe" >/dev/null 2>&1 \
      && log "write OK — created and removed a probe object" \
      || warn "wrote a probe object but could not delete it: $REMOTE/$probe (remove it by hand)"
  else
    die "$REMOTE is readable but NOT writable — backups would fail at upload time. Check the account's permissions or quota."
  fi
  log "REMOTE OK."
}

remote_browse(){
  local target="" json=0
  while [ $# -gt 0 ]; do case "$1" in
    --json) json=1;;
    --*) die "unknown browse flag: $1";;
    *) target="$1";;
  esac; shift; done
  # An explicit target needs no configured remote — requiring one here made the disconnected
  # machine unable to look around for somewhere to reconnect to.
  require_tools
  have rclone || die "rclone is not installed"
  [ -n "$target" ] || { require_remote; target="$REMOTE"; }
  local out rcode=0
  rc_capture lsd "$target" || rcode=$?
  [ "$rcode" = 0 ] || die "cannot list $target (rclone exit $rcode): $RC_ERR"
  out="$RC_OUT"
  # `lsd` prints: <size> <date> <time> <count> <name>; the name can contain spaces, so take
  # everything from field 5 on rather than splitting the whole line.
  if [ "$json" = 1 ]; then
    printf '%s\n' "$out" | python3 -c '
import json, sys
out = []
for line in sys.stdin:
    parts = line.rstrip("\n").split(None, 4)
    if len(parts) == 5 and parts[4]:
        out.append(parts[4])
print(json.dumps(out))'
  else
    printf '%s\n' "$out" | awk 'NF>=5{ $1=$1; sub(/^([^ ]+ +){4}/,""); print }'
  fi
}

remote_mkdir(){
  local target="${1:-}"
  [ -n "$target" ] || die "usage: $SELF remote mkdir <remote:path>"
  require_tools; have rclone || die "rclone is not installed"
  rc mkdir "$target" || die "could not create $target"
  log "created $target"
}

remote_set_path(){
  local target="" yes=0 dry=0
  while [ $# -gt 0 ]; do case "$1" in
    --yes|-y) yes=1;;
    --dry-run) dry=1;;
    --*) die "unknown set-path flag: $1";;
    *) target="$1";;
  esac; shift; done
  [ -n "$target" ] || die "usage: $SELF remote set-path <remote:path> [--yes]"
  case "$target" in *:*) ;; *) die "'$target' is not a remote path — it needs the form <remote>:<path>, e.g. dropbox:Backup/TIMECRATE";; esac
  # NOT require_tools cloud: this is the command that gives a disconnected machine a remote, and
  # the status output tells people to run it. Demanding one first made that advice a dead end.
  require_tools; have rclone || die "rclone is not installed"
  [ "$target" != "$REMOTE" ] || { log "already set to $target — nothing to do"; return 0; }

  # The count at each end is the whole point. Repointing away from a path that holds backups is
  # how thirteen real kits became invisible for four days; saying so first is cheap.
  # `lsf | grep -c .` turns an auth failure, an unknown remote and a network fault all into "0",
  # so a typo would read as "the new path is simply empty" and get written into the live config.
  # Same rule as everywhere else here: unlistable is UNKNOWN, never a measured zero.
  local here="" there="" trc
  trc=0; rc_capture lsf "$target" --include "$KIT_GLOB" || trc=$?
  if [ "$trc" = 0 ]; then
    there="$(printf '%s' "$RC_OUT" | grep -c . || true)"
  else
    case "$trc:$RC_ERR" in
      3:*|*"directory not found"*)
        there=0
        log "new      $target — does not exist yet; it will be created on the next upload";;
      *)
        die "cannot read $target (rclone exit $trc): $RC_ERR
  Refusing to point backups at a destination that cannot be read — check the name and try '$SELF remote test' after setting it.";;
    esac
  fi
  if [ -n "$REMOTE" ]; then
    trc=0; rc_capture lsf "$REMOTE" --include "$KIT_GLOB" || trc=$?
    [ "$trc" = 0 ] && here="$(printf '%s' "$RC_OUT" | grep -c . || true)"
  fi
  log "current  ${REMOTE:-(none)} — ${here:-UNKNOWN} backup(s)"
  [ -n "$there" ] && log "new      $target — ${there} backup(s)"
  if [ -n "$here" ] && [ "$here" -gt 0 ] && [ "${there:-0}" -eq 0 ]; then
    warn "the current path holds ${here} backup(s) and the new one holds none. They are not moved or deleted, but nothing will list or restore them until you point back."
  elif [ -z "$here" ] && [ -n "$REMOTE" ]; then
    warn "could not read the CURRENT path $REMOTE, so it is unknown whether it holds backups. If it does, they stay where they are and this machine stops seeing them."
  fi
  # --dry-run exists so a caller can show the operator the counts and the warning BEFORE anything
  # is written. Same reason as import-key --dry-run: the confirmation below reads /dev/tty, which
  # a graphical front-end does not have, and "ask first" is the entire point of this command.
  if [ "$dry" = 1 ]; then
    log "DRY RUN — nothing was changed."
    return 0
  fi
  if [ "$yes" != 1 ]; then
    printf '  Repoint backups to %s? [y/N] ' "$target"
    local ans=""; read -r ans < /dev/tty 2>/dev/null || die "not a terminal — pass --yes to change the path without a prompt"
    case "$ans" in y|Y|yes|YES) ;; *) die "unchanged — still $REMOTE";; esac
  fi
  write_user_setting TIMECRATE_REMOTE "$target"
  log "remote is now $target (written to $USER_CONF; the previous file is beside it as .bak)"
}

remote_disconnect(){
  local yes=0 drop_rclone=0
  while [ $# -gt 0 ]; do case "$1" in
    --yes|-y) yes=1;;
    --remove-rclone-remote) drop_rclone=1;;
    --*) die "unknown disconnect flag: $1";;
  esac; shift; done
  local name; name="$(remote_name)"
  if [ "$yes" != 1 ]; then
    printf '  Forget the remote %s on this machine? [y/N] ' "$REMOTE"
    local ans=""; read -r ans < /dev/tty 2>/dev/null || die "not a terminal — pass --yes"
    case "$ans" in y|Y|yes|YES) ;; *) die "unchanged";; esac
  fi
  write_user_setting TIMECRATE_REMOTE ""
  if [ "$drop_rclone" = 1 ] && [ -n "$name" ]; then
    rc config delete "$name" >/dev/null 2>&1 && log "removed the rclone remote '$name'" \
      || warn "could not remove the rclone remote '$name'"
  fi
  log "this machine no longer points at a remote."
  # Saying this out loud because "disconnect" reads like it did.
  log "NOTE: the backups themselves are untouched, and this does NOT revoke access at the provider."
  log "  Revoke it there if that is what you meant (Dropbox: Settings → Connected apps)."
}

# ============================ key lifecycle ============================
# Unprivileged BY DESIGN. Key material lives in the configured user's CONF_DIR, so running any of
# these under sudo would put the keyring in root's home, where the timers would never look for it.

ESCROW_FILE="$CONF_DIR/.escrow-confirmed"

# The severity a FAILURE is sent at. Defined once so `alerts` cannot describe one thing while
# `alerts test` exercises another; the wrapper scripts carry the same literal and a check asserts
# the two agree.
ALERT_SEVERITY="critical"

# Escrow state used to be a bare `touch`: a file that says "someone confirmed something, once".
# It cannot say WHICH key was escrowed, so it stayed "confirmed" across a key change and would
# have green-lit `harden` on a key nobody had ever copied off the box. Two lines now: fingerprint
# and ISO timestamp.
#
# A pre-v1.7.0 empty file is read as CONFIRMED-BUT-UNKNOWN and reported that way. It is never
# silently upgraded — inventing a fingerprint for it would be the same lie in a new place.
read_escrow(){
  ESC_STATE=none; ESC_FPR=""; ESC_WHEN=""
  [ -f "$ESCROW_FILE" ] || return 0
  ESC_FPR="$(sed -n 1p "$ESCROW_FILE" 2>/dev/null || true)"
  ESC_WHEN="$(sed -n 2p "$ESCROW_FILE" 2>/dev/null || true)"
  if [ -n "$ESC_FPR" ]; then ESC_STATE=confirmed; else ESC_STATE=unknown; fi
}

write_escrow_confirmed(){
  local fpr; fpr="$(head -1 "$RECIPIENTS_FILE" 2>/dev/null || true)"
  { printf '%s\n' "$fpr"; date -Is; } > "$ESCROW_FILE" 2>/dev/null || true
}

# secret half of $1 present in the tool keyring?
key_secret_present(){ [ -n "${1:-}" ] && gpg_tc --list-secret-keys "$1" >/dev/null 2>&1; }

# An unreadable keyring is not an absent one. On a box where `init` was ever run under sudo, the
# whole CONF_DIR is root-owned inside the user's home, so an unprivileged read sees nothing --
# and reporting that as "no key configured" would invite exactly the one-way door the init guard
# exists to prevent. Same lesson as the v1.5.0 config split-brain, one directory over.
# Reports WHICH path blocks the read, empty when nothing does.
#
# Three distinct ways to be unable to read a key store, and only one of them is CONF_DIR being
# unreadable. A directory needs -x as well as -r before anything inside it can be opened, and a
# perfectly traversable CONF_DIR can still hold a root-owned recipients.txt or gnupg/ -- which is
# the shape a root-run init leaves, one level down. Each of those reads back as "no key configured" unless it is
# probed for directly, which is the exact confusion this whole mechanism exists to prevent.
keyring_blocker(){
  if [ -d "$CONF_DIR" ] && { [ ! -r "$CONF_DIR" ] || [ ! -x "$CONF_DIR" ]; }; then
    printf '%s' "$CONF_DIR"; return 0
  fi
  if [ -e "$RECIPIENTS_FILE" ] && [ ! -r "$RECIPIENTS_FILE" ]; then
    printf '%s' "$RECIPIENTS_FILE"; return 0
  fi
  if [ -d "$GNUPGHOME_TC" ] && { [ ! -r "$GNUPGHOME_TC" ] || [ ! -x "$GNUPGHOME_TC" ]; }; then
    printf '%s' "$GNUPGHOME_TC"; return 0
  fi
  return 0
}
keyring_readable(){ [ -z "$(keyring_blocker)" ]; }

cmd_keys(){
  local json=0
  [ "${1:-}" = --json ] && json=1
  local efpr sfpr esec ssec spub
  efpr="$(head -1 "$RECIPIENTS_FILE" 2>/dev/null || true)"
  sfpr="$(head -1 "$SIGNING_FILE" 2>/dev/null || true)"
  # four separate facts, not one "is the secret on the box" bit: `harden` destroys the ENCRYPTION
  # secret and deliberately leaves the SIGNING secret, so collapsing them would misreport a
  # hardened box as un-hardened.
  local readable=true owner="" blocker=""
  blocker="$(keyring_blocker)"
  if [ -n "$blocker" ]; then
    readable=false
    owner="$(stat -c '%U' "$blocker" 2>/dev/null || echo unknown)"
  fi
  esec=false; key_secret_present "$efpr" && esec=true
  ssec=false; key_secret_present "$sfpr" && ssec=true
  spub=false; [ -s "$SIGNING_PUB" ] && spub=true
  read_escrow

  if [ "$json" = 1 ]; then
    TC_K_EFPR="$efpr" TC_K_SFPR="$sfpr" TC_K_ESEC="$esec" TC_K_SSEC="$ssec" TC_K_SPUB="$spub" \
    TC_K_ESTATE="$ESC_STATE" TC_K_EWHO="$ESC_FPR" TC_K_EWHEN="$ESC_WHEN" \
    TC_K_ESCROW_FILE="$SECRET_ESCROW" TC_K_READABLE="$readable" TC_K_OWNER="$owner" \
    TC_K_CONFDIR="${blocker:-$CONF_DIR}" TC_K_PQFPR="$(pq_fpr)" TC_K_PQSEC="$PQ_SECRET" \
    TC_K_PQPUB="$PQ_PUBLIC" TC_K_CRYPTO="$CRYPTO" \
    python3 -c '
import json, os
e = os.environ.get
print(json.dumps({
  "encryption_fpr": e("TC_K_EFPR",""), "encryption_secret_present": e("TC_K_ESEC")=="true",
  "signing_fpr": e("TC_K_SFPR",""), "signing_secret_present": e("TC_K_SSEC")=="true",
  "signing_public_present": e("TC_K_SPUB")=="true",
  "escrow_state": e("TC_K_ESTATE","none"), "escrow_fpr": e("TC_K_EWHO",""),
  "escrow_when": e("TC_K_EWHEN",""),
  "escrow_file_on_box": os.path.exists(e("TC_K_ESCROW_FILE","")),
  # false means "cannot tell", NOT "nothing is there" -- a caller that treats the two alike
  # would offer to generate a key on a machine that already has one
  "keyring_readable": e("TC_K_READABLE") != "false",
  "keyring_owner": e("TC_K_OWNER",""), "config_dir": e("TC_K_CONFDIR",""),
  "pq_fpr": e("TC_K_PQFPR",""), "pq_secret_present": os.path.exists(e("TC_K_PQSEC","")),
  "pq_public_present": os.path.exists(e("TC_K_PQPUB","")), "crypto": e("TC_K_CRYPTO","classic"),
}))'
    return 0
  fi

  echo "Keys"
  if [ "$readable" = false ]; then
    printf '  keyring      UNREADABLE — %s is owned by %s and you are %s.\n' \
      "$blocker" "$owner" "$(id -un)"
    printf '               Nothing below can be reported. This is what an `init` run under sudo\n'
    printf '               leaves behind. Read it with:  sudo %s keys\n' "$SELF"
    return 0
  fi
  if [ -n "$efpr" ]; then
    printf '  encryption   %s  (RSA-4096)\n' "$efpr"
    if [ "$esec" = true ]; then
      printf '  secret half  ON THIS BOX — this machine can decrypt its own backups\n'
    else
      printf '  secret half  NOT on this box — encrypt-only (hardened, or never imported).\n'
      printf '               Restoring here needs '\''%s import-key <escrowed file>'\''\n' "$SELF"
    fi
  else
    printf '  encryption   NONE CONFIGURED — nothing can be backed up or restored yet.\n'
    printf '               Recovering an existing machine?  %s import-key <escrowed file>\n' "$SELF"
    printf '               Setting up a brand new one?      %s init\n' "$SELF"
  fi
  if [ -n "$sfpr" ]; then
    printf '  signing      %s  (secret %s, public key %s)\n' "$sfpr" \
      "$([ "$ssec" = true ] && echo present || echo absent)" \
      "$([ "$spub" = true ] && echo present || echo MISSING)"
  else
    printf '  signing      none — kits from this box would be unsigned (pre-v1.3.0 behaviour)\n'
  fi
  if [ -s "$PQ_PUBLIC" ]; then
    printf '  post-quantum %s  (ML-KEM-1024, secret %s; kit posture: %s)\n' "$(pq_fpr)" \
      "$([ -f "$PQ_SECRET" ] && echo present || echo absent)" "$CRYPTO"
  else
    printf '  post-quantum none — kits use the classic GPG envelope (posture: %s). Add one: %s pq init\n' "$CRYPTO" "$SELF"
  fi
  case "$ESC_STATE" in
    none)      printf '  escrow       NOT CONFIRMED — if the secret key is lost these backups are unrecoverable\n';;
    unknown)   printf '  escrow       confirmed, but by a pre-1.7.0 version that did not record which key or when.\n'
               printf '               Re-run '\''%s escrow-confirm'\'' to record it properly.\n' "$SELF";;
    confirmed) if [ "$ESC_FPR" = "$efpr" ]; then
                 printf '  escrow       confirmed %s for %s\n' "$ESC_WHEN" "$ESC_FPR"
               else
                 printf '  escrow       STALE — confirmed for %s, but the current key is %s\n' "$ESC_FPR" "$efpr"
               fi;;
  esac
}

# Import an escrowed secret key. Validated in a THROWAWAY keyring first: a key that fails these
# checks must never touch the live one, because the failure mode is only visible years later at a
# restore.
cmd_import_key(){
  local src="" spub="" replace=0 yes=0 dry=0
  while [ $# -gt 0 ]; do case "$1" in
    --signing-pub) spub="${2:-}"; shift;;
    --replace) replace=1;;
    --yes|-y) yes=1;;
    --dry-run) dry=1;;
    --*) die "unknown import-key flag: $1";;
    *) src="$1";;
  esac; shift; done
  [ -n "$src" ] || die "usage: $SELF import-key <file|-> [--signing-pub <file>] [--replace] [--yes] [--dry-run]"

  local t; t="$(mktemp -d)"; chmod 700 "$t"
  # shellcheck disable=SC2064
  trap "rm -rf '$t'" EXIT
  local key="$t/in.asc"
  if [ "$src" = - ]; then cat > "$key"; else
    [ -r "$src" ] || die "cannot read '$src'"
    cp "$src" "$key"
  fi
  [ -s "$key" ] || die "'$src' is empty"

  mkdir -p "$t/ring"; chmod 700 "$t/ring"
  GNUPGHOME="$t/ring" gpg --batch --import "$key" >/dev/null 2>&1 \
    || die "'$src' is not a key GnuPG can read"
  local info
  info="$(GNUPGHOME="$t/ring" gpg --batch --with-colons --list-secret-keys 2>/dev/null || true)"
  [ -n "$info" ] || die "no SECRET key in '$src' — this looks like a public-key export. The escrowed file is the one that starts 'BEGIN PGP PRIVATE KEY BLOCK'."

  local fpr
  fpr="$(printf '%s\n' "$info" | awk -F: '/^fpr:/{print $10; exit}')"
  # The algorithm that matters is the one on the ENCRYPTION-capable part, not the primary: gpg
  # encrypts to the encryption subkey, so an RSA primary carrying a cv25519 encryption subkey
  # passes a primary-only test and then fails to decrypt after re-import — the precise trap this
  # refuses. Every encryption-capable part must be RSA, because gpg picks among them, not us.
  # lowercase 'e' only: the capability field carries this key's own caps in lowercase and the
  # whole key's aggregate in uppercase, so tolower() would credit an ECC primary with its
  # subkey's encryption capability and then report the primary's algorithm.
  printf '%s\n' "$info" | awk -F: '($1=="sec"||$1=="ssb") && $12 ~ /e/ {f=1} END{exit !f}' \
    || die "key $fpr has no encryption-capable part — it cannot decrypt a Timecrate kit"
  local badalgo
  badalgo="$(printf '%s\n' "$info" | awk -F: '($1=="sec"||$1=="ssb") && $12 ~ /e/ && $4!=1 {print $4; exit}')"
  [ -z "$badalgo" ] \
    || die "key $fpr encrypts with a non-RSA key (GnuPG algorithm $badalgo). Exported ed25519/cv25519 secret keys do not decrypt after re-import in this GnuPG — importing this would leave every backup unreadable."
  printf '%s\n' "$info" | awk -F: '$1=="sec" && ($2=="r"||$2=="e"){bad=1} END{exit bad}' \
    || die "key $fpr is expired or revoked"

  local cur; cur="$(head -1 "$RECIPIENTS_FILE" 2>/dev/null || true)"
  if [ -n "$cur" ] && [ "$cur" != "$fpr" ] && [ "$replace" != 1 ]; then
    die "a different key is already configured ($cur). Pass --replace to make $fpr the recipient for NEW backups — the old secret is kept, so existing kits stay readable."
  fi

  # --dry-run exists so a caller can show the operator WHICH key it is about to trust before
  # anything is written. The confirmation prompt below reads /dev/tty, which a graphical front-end
  # does not have, so without this the GUI's only options would be "import blind" or "no GUI".
  # Bare fingerprint on stdout; every other word this command says goes to stderr.
  if [ "$dry" = 1 ]; then
    printf '%s\n' "$fpr"
    warn "validated: RSA, encryption-capable, not expired. NOT imported (--dry-run)."
    return 0
  fi

  log "key in '$src': $fpr — RSA, encryption-capable, not expired"
  if [ "$yes" != 1 ]; then
    printf '  Import this as the Timecrate decryption key? [y/N] '
    local ans=""; read -r ans < /dev/tty 2>/dev/null || die "not a terminal — pass --yes to import without a prompt"
    case "$ans" in y|Y|yes|YES) ;; *) die "aborted — nothing was imported";; esac
  fi

  umask 077; mkdir -p "$CONF_DIR" "$GNUPGHOME_TC" "$STATE_DIR"; chmod 700 "$GNUPGHOME_TC"
  # an agent started against this homedir BEFORE the wipe (the in-place reinstall drill)
  # serves the old keyring from cache; kill it so the import below is read fresh — the same
  # reason the recovery drill kills the agent after importing. Harmless when none is running.
  GNUPGHOME="$GNUPGHOME_TC" gpgconf --kill gpg-agent >/dev/null 2>&1 || true
  gpg_tc --import "$key" >/dev/null 2>&1 || die "import into $GNUPGHOME_TC failed"
  # --replace ADDS: the previous secret stays in the keyring on purpose, or every kit encrypted
  # to it before today becomes unreadable the moment this command runs.
  printf '%s\n' "$fpr" > "$RECIPIENTS_FILE"
  log "imported. $fpr is now the recipient for new backups."
  [ -n "$cur" ] && [ "$cur" != "$fpr" ] && log "  previous key $cur kept in the keyring — kits encrypted to it still restore."

  if [ -n "$spub" ]; then
    [ -r "$spub" ] || die "cannot read signing public key '$spub'"
    gpg_tc --import "$spub" >/dev/null 2>&1 || die "'$spub' is not a key GnuPG can read"
    local sfpr
    sfpr="$(GNUPGHOME="$GNUPGHOME_TC" gpg --batch --with-colons --import-options show-only --import "$spub" 2>/dev/null \
             | awk -F: '/^fpr:/{print $10; exit}')"
    [ -n "$sfpr" ] || die "could not read a fingerprint from '$spub'"
    cp "$spub" "$SIGNING_PUB"; chmod 644 "$SIGNING_PUB"
    printf '%s\n' "$sfpr" > "$SIGNING_FILE"
    log "signing public key pinned: $sfpr — restores from this box will verify signatures."
  elif [ ! -s "$SIGNING_PUB" ]; then
    warn "no signing public key here — restore can decrypt but cannot AUTHENTICATE a kit. Import it with --signing-pub (it is on the escrow sheet)."
  fi
  write_status
  log "check it worked:  $SELF verify-key"
}

# "Can THIS box read my backups?" — distinct from recovery-drill, which proves the ESCROWED key
# works. A box can pass the drill and still be unable to restore, which is exactly the state a
# freshly reinstalled machine is in.
cmd_verify_key(){
  local deep=0
  while [ $# -gt 0 ]; do case "$1" in
    --deep) deep=1;;
    --*) die "unknown verify-key flag: $1";;
    *) die "verify-key takes no arguments";;
  esac; shift; done
  require_tools cloud
  local cur; cur="$(head -1 "$RECIPIENTS_FILE" 2>/dev/null || true)"
  if [ -z "$cur" ] && ! keyring_readable; then
    die "cannot read the keyring: $(keyring_blocker) is owned by $(stat -c '%U' "$(keyring_blocker)" 2>/dev/null || echo '?') and you are $(id -un). Retry with sudo, or fix its ownership — this is NOT the same as having no key"
  fi
  [ -n "$cur" ] || die "no key configured — run '$SELF import-key <escrowed file>' first"

  local name
  name="$(rc lsf "$REMOTE" --include "$KIT_GLOB" 2>/dev/null | kit_sort | tail -1)" || true
  [ -n "$name" ] || die "no kit on $REMOTE to check against (cannot list it, or it is empty)"

  local t; t="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$t'" EXIT

  if [ "$deep" = 1 ]; then
    log "fetching $name and decrypting it in full…"
    rc copyto "$REMOTE/$name" "$t/kit.gpg" || die "could not fetch $name"
    # signature verification is NOT optional here: a check that says "yes you can read this" about
    # a kit it never authenticated is worth less than no check at all.
    decrypt_verified "$t/kit.gpg" "$t/out.bin" 0
    log "VERIFY-KEY OK (deep) — this box decrypted and authenticated $name"
    return 0
  fi

  # header only: the recipient key-id is in the first packet, so a few KB answers the question
  # without pulling 9 MB.
  rc cat "$REMOTE/$name" --count 8192 > "$t/head.gpg" 2>/dev/null || die "could not read $name"
  local want
  want="$(gpg --batch --list-only --list-packets "$t/head.gpg" 2>/dev/null \
          | sed -n 's/.*keyid \([0-9A-Fa-f]*\).*/\1/p' | tr 'a-f' 'A-F' | sort -u)" || true
  [ -n "$want" ] || die "could not read the recipient key-id from $name"

  local have_ids
  have_ids="$(gpg_tc --with-colons --list-secret-keys 2>/dev/null \
              | awk -F: '($1=="sec"||$1=="ssb"){print toupper($5)}' | sort -u)" || true
  local hit=""
  hit="$(comm -12 <(printf '%s\n' "$want") <(printf '%s\n' "$have_ids") | head -1)" || true
  if [ -z "$hit" ]; then
    die "this box CANNOT read $name — it is encrypted to $(printf '%s' "$want" | tr '\n' ' ')and no matching secret key is installed. Import the escrowed key:  $SELF import-key <file>"
  fi
  local hit_fpr
  hit_fpr="$(gpg_tc --with-colons --list-secret-keys "$hit" 2>/dev/null | awk -F: '/^fpr:/{print $10; exit}')" || true
  log "VERIFY-KEY OK — $name is encrypted to a key this box holds (${hit_fpr:-$hit})"
  log "  header check only; '$SELF verify-key --deep' decrypts and authenticates the whole kit."
}

# Re-escrow. Writing this into the backup set would put the key inside the kits it decrypts, which
# is the chicken-and-egg failure the escrow exists to avoid.
cmd_export_key(){
  local out=""
  while [ $# -gt 0 ]; do case "$1" in
    --out) out="${2:-}"; shift;;
    --*) die "unknown export-key flag: $1";;
    *) die "usage: $SELF export-key [--out <file>]";;
  esac; shift; done
  local fpr; fpr="$(head -1 "$RECIPIENTS_FILE" 2>/dev/null || true)"
  if [ -z "$fpr" ] && ! keyring_readable; then
    die "cannot read the keyring: $(keyring_blocker) is owned by $(stat -c '%U' "$(keyring_blocker)" 2>/dev/null || echo '?') and you are $(id -un). Retry with sudo, or fix its ownership"
  fi
  [ -n "$fpr" ] || die "no key configured"
  key_secret_present "$fpr" || die "the secret half of $fpr is not on this box (hardened, or never imported) — there is nothing here to export"

  if [ -n "$out" ]; then
    local abs; abs="$(readlink -f "$out" 2>/dev/null || printf '%s' "$out")"
    case "$abs/" in
      "$CONF_DIR"/*|"$STAGING_ROOT"/*) ;;   # both are excluded from every kit by derivation
      *) local line
         while IFS= read -r line; do
           [ -n "$line" ] || continue
           case "$abs/" in "/$line/"*)
             die "refusing to write the secret key to $abs — that path is inside the backup include set, which would ship the key inside the kits it decrypts";;
           esac
         done < <(build_include);;
    esac
    umask 077
    gpg_tc --armor --export-secret-keys "$fpr" > "$out" || die "export failed"
    chmod 600 "$out"
    log "secret key $fpr written to $out — move it OFF this machine, then '$SELF escrow-confirm'."
  else
    gpg_tc --armor --export-secret-keys "$fpr"
  fi
}

cmd_pq(){
  local sub="${1:-status}"; [ $# -gt 0 ] && shift
  case "$sub" in
    init) pq_init;;
    import)
      local f="" replace=0 a
      for a in "$@"; do case "$a" in
        --replace) replace=1;;
        --*) die "unknown pq import flag: $a";;
        *) f="$a";;
      esac; done
      [ -n "$f" ] && [ -f "$f" ] || die "usage: $SELF pq import <pq-secret.pem> [--replace]"
      pq_supported || die "this openssl has no ML-KEM-1024 (need OpenSSL 3.5+) — import the key on a newer box"
      openssl pkey -in "$f" -noout -check >/dev/null 2>&1 || die "$f is not a readable private key"
      # captured, not piped into grep -q: under pipefail the SIGPIPE would fail the check
      case "$(openssl pkey -in "$f" -text -noout 2>/dev/null)" in
        *ML-KEM-1024*) ;;
        *) die "$f is not an ML-KEM-1024 key — refusing to install it as the PQ secret";;
      esac
      if [ -f "$PQ_SECRET" ] && ! cmp -s "$f" "$PQ_SECRET"; then
        [ "$replace" = 1 ] || die "a DIFFERENT PQ secret already exists at $PQ_SECRET — pass --replace to overwrite it (kits wrapped for the old key will not open)"
      fi
      umask 077; mkdir -p "$CONF_DIR"
      install -m 600 "$f" "$PQ_SECRET"
      openssl pkey -in "$PQ_SECRET" -pubout -out "$PQ_PUBLIC" 2>/dev/null || die "could not derive the PQ public key"
      chmod 644 "$PQ_PUBLIC"
      log "PQ secret installed (ML-KEM-1024, fingerprint $(pq_fpr))"
      ;;
    status)
      local sup=0; pq_supported && sup=1
      if [ "${1:-}" = --json ]; then
        TC_PQ_SUP="$sup" TC_PQ_FPR="$(pq_fpr)" TC_PQ_SEC="$PQ_SECRET" TC_PQ_PUB="$PQ_PUBLIC" \
        TC_PQ_CRYPTO="$CRYPTO" python3 -c '
import json, os
e = os.environ.get
print(json.dumps({
  "supported": e("TC_PQ_SUP") == "1", "alg": "ML-KEM-1024", "fpr": e("TC_PQ_FPR", ""),
  "secret_present": os.path.exists(e("TC_PQ_SEC", "")), "public_present": os.path.exists(e("TC_PQ_PUB", "")),
  "crypto": e("TC_PQ_CRYPTO", "classic")}))'
        return 0
      fi
      echo "Post-quantum (ML-KEM-1024 envelope for hybrid kits)"
      printf '  openssl ML-KEM   %s\n' "$([ "$sup" = 1 ] && echo available || echo 'NOT available (need OpenSSL 3.5+)')"
      if [ -f "$PQ_PUBLIC" ]; then
        printf '  key              ML-KEM-1024  %s\n' "$(pq_fpr)"
        printf '  secret half      %s\n' "$([ -f "$PQ_SECRET" ] && echo 'ON THIS BOX — this machine can open hybrid kits' || echo 'NOT on this box (escrow only)')"
      else
        printf '  key              NONE — run: %s pq init\n' "$SELF"
      fi
      printf '  kit posture      %s (TIMECRATE_CRYPTO)\n' "$CRYPTO"
      ;;
    *) die "unknown pq subcommand '$sub' — expected init, import or status";;
  esac
}

# ============================ dispatch ============================
cmd="${1:-help}"; shift || true
case "$cmd" in
  init) cmd_init "$@";;  harden) need_root harden; cmd_harden "$@";;
  backup) cmd_backup "$@";;  restore) cmd_restore "$@";;
  list) cmd_list "$@";;  verify) cmd_verify "$@";;  demo) cmd_demo "$@";;  status) cmd_status "$@";;
  config) cmd_config "$@";;  schedule) cmd_schedule "$@";;
  break-glass|breakglass) cmd_break_glass "$@";;
  escrow-doc) cmd_escrow_doc "$@";;
  recovery-drill|drill) cmd_recovery_drill "$@";;
  escrow-confirm) need_root escrow-confirm; cmd_escrow_confirm "$@";;
  # key lifecycle: unprivileged on purpose -- under sudo the keyring lands in root's home
  remote) cmd_remote "$@";;
  paths) cmd_paths "$@";;
  coverage) cmd_coverage "$@";;
  pause) cmd_pause "$@";;
  history) cmd_history "$@";;
  alerts) cmd_alerts "$@";;
  pq) cmd_pq "$@";;
  keys) cmd_keys "$@";;  import-key|import) cmd_import_key "$@";;
  verify-key) cmd_verify_key "$@";;  export-key) cmd_export_key "$@";;
  version|--version) echo "timecrate $VERSION";;
  help|-h|--help) cmd_help;;
  *) die "unknown command '$cmd' (try: $SELF help)";;
esac
