# Kits written before 3.0.0 carry the previous name; they are the same series.
KIT_RE = re.compile(r"(?:timecrate|timemachine)-(\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2})\.tar\.zst\.gpg$")
# `restore` ends with: inspect <dir>/extracted ; RESTORE.md in /usr/share/doc/timecrate ...
STAGED_RE = re.compile(r"inspect\s+(\S+/extracted)\b")
# run_async merges stderr into stdout, so `import-key --dry-run`'s fingerprint is identified
# by shape rather than by position.
FPR_RE = re.compile(r"^[0-9A-F]{40}$")
# pkexec's own exit codes: 126 = the user dismissed the authentication dialog, 127 = not authorised.
PKEXEC_CANCELLED, PKEXEC_NOT_AUTHORISED = 126, 127
# How far a kit may differ from the one before it before the row says so. Backups of a machine's
# configuration are near-identical night to night, so a third is already a real event -- either
# something large arrived in the include set, or something large fell out of it.
KIT_DEVIATION = 0.33


def human_bytes(value):
    """Bytes as a short string. '' or None is 'unknown' -- never '0 B'."""
    if value in ("", None):
        return "unknown"
    try:
        n = float(value)
    except (TypeError, ValueError):
        return "unknown"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return "%d B" % n if unit == "B" else "%.1f %s" % (n, unit)
        n /= 1024

