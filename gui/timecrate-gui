    # ---------- running things ----------

    def _allowed_args(self, args):
        if args in (["backup"], ["backup", "--dry-run"], ["recovery-drill"]):
            return True
        if args[:1] == ["restore"] and len(args) == 2:
            return args[1] in self.kit_names
        # restore --to-root overwrites /, so the kit still has to be one the remote actually
        # listed; the typed confirmation is upstream of this, not a substitute for it.
        if args[:1] == ["restore"] and len(args) == 3 and args[2] == "--to-root":
            return args[1] in self.kit_names
        # break-glass <kit> <target>: both come from a file chooser, and both are re-checked
        # here because a path that vanished between choosing and running would otherwise be
        # handed to a root process.
        # / is excluded because extracting a kit there overwrites the running system, which is
        # restore --to-root's job and gated by the typed confirmation. The engine refuses it too,
        # and that refusal is the actual boundary — this one only makes the window say so without
        # spending an administrator prompt first.
        if args[:1] == ["break-glass"] and len(args) == 3:
            return (os.path.isfile(args[1]) and os.access(args[1], os.R_OK)
                    and os.path.isdir(args[2]) and os.access(args[2], os.R_OK)
                    and os.path.realpath(args[2]) != "/")
        if args in (["escrow-confirm"], ["alerts", "test"]):
            return True
        # paths <include|exclude> <add|remove> <path>: the list name comes from a fixed pair and
        # the engine re-validates the path itself (no newline, no ..), so this stays an
        # enumeration rather than a pattern that could be talked into something else.
        if (args[:1] == ["paths"] and len(args) == 4
                and args[1] in ("include", "exclude") and args[2] in ("add", "remove")):
            return True
        if args[:1] == ["schedule"] and len(args) in (3, 5):
            return (args[1] in ("backup", "drill") and args[2] in ("on", "off")
                    and (len(args) == 3 or args[3] == "--at"))
        return False

