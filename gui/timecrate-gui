    def run_readonly(self, args, title, success):
        """Run a command that needs no root: same busy/log treatment as run(), without pkexec.

        `verify` requires no privilege — it reads the remote and decrypts into the user's own
        staging directory — so asking for an administrator password to run a read-only check
        would be theatre, and a prompt the user learns to click through is worse than no prompt.

        Until 2.6.0 there was a second, sharper reason: pkexec sets no SUDO_USER, so on a machine
        that had not pinned TIMECRATE_USER the engine resolved the account to root and looked
        for the keyring in root's home, where it is not. The engine reads PKEXEC_UID now, so a
        privileged verify would resolve correctly — but it would still be an administrator prompt
        for a read-only check, which is reason enough on its own.
        """
        if self.busy:
            return
        self.last_error = ""
        self.warnings = []
        self._set_busy(True)
        self._set_operation(title, "Fetching and checking — this reads the remote.", 0.05)
        self.banner.set_revealed(False)
        self.log_line("$ " + " ".join([TC] + args))

        def finished(ok, out):
            for line in out.splitlines():
                self.log_line(line)
                if "[timecrate][WARN]" in line:
                    self.warnings.append(self._clean(line))
            self._set_busy(False)
            if ok:
                self._set_operation(success, "Up to date.", 1.0)
                self.toast(success)
                self._set_banner(success)
            else:
                lines = [ln for ln in out.strip().splitlines() if ln.strip()]
                message = self._clean(lines[-1]) if lines else "%s failed." % title
                self._set_operation("It did not work", message, 1.0)
                self._set_banner(message)
                self.log_expander.set_expanded(True)
                self.toast("Failed")
            # Same rule as a privileged run: a warning outranks the success banner. A verify that
            # passed while also saying "checksum step SKIPPED" is not a clean verify.
            if self.warnings:
                summary = self.warnings[0] if len(self.warnings) == 1 else \
                    "%s (and %d more in the log)" % (self.warnings[0], len(self.warnings) - 1)
                self._set_banner("Warning: " + summary)
                self.log_expander.set_expanded(True)

        run_async([TC] + args, finished)

    def confirm_restore_to_root(self):
        if self.busy:
            return
        if not self.kit_names:
            self.report("There is no backup on the remote to restore from.")
            return
        newest = self.kit_names[0]
        dialog = Adw.AlertDialog(
            heading="Restore over this running system?",
            body="%s will be fetched, its signature verified, and then extracted straight over / "
                 "as root. Files on this machine are overwritten with the versions in that "
                 "backup, and there is no undo.\n\nType RESTORE to confirm." % self._kit_display(newest))
        entry = Gtk.Entry(placeholder_text="RESTORE")
        dialog.set_extra_child(entry)
        # kept so the smoke test can prove the gate actually gates; nothing else reads them
        self._to_root_dialog, self._to_root_entry = dialog, entry
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Restore over /")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("go", False)
        dialog.set_close_response("cancel")
        entry.connect("changed",
                      lambda e: dialog.set_response_enabled("go", e.get_text() == "RESTORE"))

        def responded(_dialog, response):
            # Re-checked here and not only through the disabled button: a default response or an
            # accelerator must not be able to start this without the word being typed.
            if response == "go" and entry.get_text() == "RESTORE":
                self.run(["restore", newest, "--to-root"])

        dialog.connect("response", responded)
        dialog.present(self)

    def choose_break_glass(self):
        if self.busy:
            return
        kit_dialog = Gtk.FileDialog()
        kit_dialog.set_title("Encrypted kit to recover from")

        def picked_kit(source, result):
            try:
                kit = source.open_finish(result).get_path()
            except GLib.Error:
                return                      # cancelled — not an error worth reporting
            target_dialog = Gtk.FileDialog()
            target_dialog.set_title("Where to extract it")

            def picked_target(src, res):
                try:
                    target = src.select_folder_finish(res).get_path()
                except GLib.Error:
                    return
                if os.path.realpath(target) == "/":
                    self.report("Break-glass extracts into a folder so you can inspect what is "
                                "in the backup. To write a backup over this running system, use "
                                "“Restore to /”, which asks you to confirm first.")
                    return
                self.run(["break-glass", kit, target])

            target_dialog.select_folder(self, None, picked_target)

        kit_dialog.open(self, None, picked_kit)

    def run(self, args):
        if self.busy:
            return
        if not self._allowed_args(args):
            self.report("Blocked an unsupported privileged command: %s" % " ".join(args))
            return

        argv = ["pkexec", TC] + args
        self.current_kind = self._kind_for_args(args)
        self.last_error = ""
        self.warnings = []
        self.staged_path = ""
        self._set_busy(True)
        self._set_operation(self._operation_name(), "Waiting for administrator approval…", 0.02)
        self.banner.set_revealed(False)
        self.log_line("$ " + " ".join(argv))

        try:
            proc = Gio.Subprocess.new(
                argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as exc:
            self.log_line("ERROR: " + exc.message)
            self._finish_action(False, exc.message)
            return
        self._pump(Gio.DataInputStream.new(proc.get_stdout_pipe()), proc)

    def _operation_name(self):
        return {
            "backup": "Backing up", "dry-run": "Previewing",
            "recovery-drill": "Running a recovery drill", "restore": "Restoring",
            "schedule": "Updating the schedule", "escrow-confirm": "Recording the escrow",
            "paths": "Updating the backup list", "alerts": "Sending a test alert",
            "break-glass": "Break-glass recovery",
        }.get(self.current_kind, "Working")

    def _operation_success(self):
        return {
            "backup": "Backup complete", "dry-run": "Preview complete",
            "recovery-drill": "Recovery drill passed",
            "restore": "Restore staged for inspection", "schedule": "Schedule updated",
        }.get(self.current_kind, "Done")

    def _pump(self, stream, proc):
        def on_line(source, result):
            try:
                line, _length = source.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                proc.wait_async(None, on_done)
                return
            self.log_line(line)
            self._handle_progress_line(line)
            source.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        def on_done(process, result):
            try:
                process.wait_finish(result)
            except GLib.Error as exc:
                self._finish_action(False, self.last_error or exc.message)
                return
            status = process.get_exit_status() if process.get_if_exited() else -1
            # pkexec's own codes, not the tool's. "failed: code 126" for a dismissed password
            # prompt reads like a crash, and it is the most common outcome of clicking Cancel.
            if status == PKEXEC_CANCELLED and not self.last_error:
                self._finish_action(None, "Cancelled at the authentication prompt. Nothing ran.")
                return
            if status == PKEXEC_NOT_AUTHORISED and not self.last_error:
                self._finish_action(False, "Not authorised. This needs an administrator account.")
                return
            self._finish_action(status == 0 and not self.last_error, self.last_error)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    def _handle_progress_line(self, line):
        if "[timecrate][ERROR]" in line:
            self.last_error = line
            self._set_operation(self._operation_name(), self._clean(line), 1.0)
            return
        # Warnings are how the engine reports a stale drill, a missing include, unpushed commits
        # or an escrow copy it could not verify. They used to scroll past inside a collapsed log.
        if "[timecrate][WARN]" in line:
            self.warnings.append(self._clean(line))
            return
        if "RECOVERY DRILL FAILED" in line:
            self.last_error = line
            return
        match = STAGED_RE.search(line)
        if match:
            self.staged_path = match.group(1)
        for needle, label, fraction in MILESTONES.get(self.current_kind, []):
            if needle in line:
                self._set_operation(self._operation_name(), label, fraction)
                return

    def _finish_action(self, ok, error):
        self._set_busy(False)
        kind, staged = self.current_kind, self.staged_path
        self.current_kind = None

        if ok is None:  # cancelled: neither a success nor a failure
            self.progress.set_fraction(0.0)
            self._set_operation("Cancelled", error, 0.0)
            self.toast("Cancelled")
        elif ok:
            self.progress.set_fraction(1.0)
            detail = "Extracted to %s" % staged if kind == "restore" and staged else "Up to date."
            self._set_operation(self._success_title(kind), detail, 1.0)
            self.toast(self._success_title(kind))
            if kind == "restore" and staged:
                self._set_banner("Restored to %s" % staged, "Show Folder",
                                 lambda: Gio.AppInfo.launch_default_for_uri("file://" + staged, None))
            else:
                self._set_banner(self._success_title(kind))
        else:
            message = self._clean(error) if error else "It failed. See the log for what happened."
            self._set_operation("It did not work", message, 1.0)
            self._set_banner(message)
            self.log_expander.set_expanded(True)
            self.toast("Failed")

        # A warning outranks a success banner: an `ok` backup that also said DRILL STALE or
        # "include entry missing on disk" is exactly the run you must not walk away from.
        if self.warnings:
            summary = self.warnings[0] if len(self.warnings) == 1 else \
                "%s (and %d more in the log)" % (self.warnings[0], len(self.warnings) - 1)
            self._set_banner("Warning: " + summary)
            self.log_expander.set_expanded(True)

        self.refresh()
        if self.pending_privileged:
            self.run(self.pending_privileged.pop(0))
        elif self._privileged_done is not None:
            # Only once the queue is drained: a dialog that reloaded after each queued command
            # would show a half-applied list.
            done, self._privileged_done = self._privileged_done, None
            done()

    def _success_title(self, kind):
        return {
            "backup": "Backup complete", "dry-run": "Preview complete",
            "recovery-drill": "Recovery drill passed",
            "restore": "Restore staged for inspection", "schedule": "Schedule updated",
        }.get(kind, "Done")

    def _clean(self, line):
        if not line:
            return ""
        text = line.strip()
        for marker in ("[timecrate][ERROR]", "[timecrate][WARN]", "[timecrate]"):
            if marker in text:
                return text.split(marker, 1)[1].strip()
        return text

    # ---------- refreshing ----------

    def _check_keys(self):
        """A window that renders errors until someone opens a terminal is not a recovery tool."""
        def done(ok, out):
            if not ok:
                return
            try:
                keys = json.loads(out)
            except ValueError:
                return
            self.keys = keys
            if keys.get("encryption_fpr") or self._first_run_shown:
                return
            if not keys.get("keyring_readable", True):
                # cannot see a key is not the same as not having one. Offering to generate here
                # is how a machine with fifteen live backups ends up with a brand new identity.
                self._set_banner(
                    "The key store cannot be read by this account (%s owns %s)"
                    % (keys.get("keyring_owner") or "another user",
                       keys.get("config_dir") or "it"))
                return
            self._first_run_shown = True
            self._first_run()

        run_async([TC, "keys", "--json"], done)

    def _first_run(self):
        dialog = Adw.AlertDialog(
            heading="This machine has no key",
            body="Backups are encrypted to a key that lives here and nowhere in the backups "
                 "themselves.\n\nIf you are rebuilding a machine, bring the escrowed key back — "
                 "generating a new one would leave every existing backup unreadable. If this is a "
                 "genuinely new machine, set one up.")
        dialog.add_response("later", "Later")
        dialog.add_response("new", "Set up a new machine")
        dialog.add_response("import", "Import an escrowed key")
        dialog.set_response_appearance("import", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("import")
        dialog.set_close_response("later")

        def answered(_d, response):
            if response == "import":
                ImportKeyDialog(self, self.refresh).present(self)
            elif response == "new":
                self.log_line("$ timecrate init")

                def done(ok, out):
                    last = out.strip().splitlines()[-1] if out.strip() else ""
                    # init refuses when the remote already holds kits -- that refusal IS the
                    # feature, so it has to reach the operator, not the log alone
                    if ok:
                        self.toast("New key generated — export it for escrow now")
                    else:
                        self.report(self._clean(last) or "Could not set up a new key.")
                    self.log_line(self._clean(last))
                    self.refresh()

                run_async([TC, "init"], done)

        dialog.connect("response", answered)
        dialog.present(self)

    def refresh(self):
        run_async([TC, "status", "--json"], self._on_status)
        run_async([TC, "list", "--long"], self._on_kits)
        run_async([TC, "history", "--json"], self._on_history)
        self._check_keys()

    def _on_status(self, ok, out):
        if not ok:
            self.report("Cannot read status from %s. Is Timecrate installed?" % TC)
            for row in (self.r_last, self.r_cloud, self.r_local, self.r_conf,
                        self.r_cipher, self.r_key, self.r_escrow, self.r_drill):
                row.set_subtitle("unknown")
            for pill in (self.p_cloud, self.p_escrow, self.p_drill):
                self._set_pill(pill, "UNKNOWN", "neutral")
            return
        try:
            data = json.loads(out)
        except ValueError:
            self.report("Status was not valid JSON. See the log.")
            self.log_line(out)
            return

        self.status = data
        self.r_last.set_subtitle(self._last_backup_text(data.get("last_backup") or ""))

        count = data.get("cloud_kits", "")
        self.r_cloud.set_subtitle(data.get("remote") or "no remote configured")
        # "" means the remote could not be read; "0" means it answered and holds nothing. Neither
        # is success, and collapsing the two into a green "0 KITS" is exactly how an unreachable
        # remote once looked healthy.
        if count == "":
            self._set_pill(self.p_cloud, "UNREADABLE", "error")
        elif str(count) == "0":
            self._set_pill(self.p_cloud, "NO BACKUPS", "error")
        else:
            self._set_pill(self.p_cloud,
                           "%s KIT%s" % (count, "" if str(count) == "1" else "S"), "success")

        # Space, stated only as far as it was actually measured: "" is not-measured, and saying
        # "0 B" or "0% used" for a remote nobody could reach is the same lie the kit count used
        # to tell.
        extra = []
        if data.get("cloud_bytes") not in ("", None):
            extra.append("These backups total %s." % human_bytes(data.get("cloud_bytes")))
        if data.get("remote_quota_total") not in ("", None):
            extra.append("The remote holds %s of %s."
                         % (human_bytes(data.get("remote_quota_used")),
                            human_bytes(data.get("remote_quota_total"))))
        self.kit_group.set_description(" ".join([self.KIT_GROUP_DESC] + extra))

        local = data.get("local_kits", 0)
        self.r_local.set_subtitle(
            "none kept here — the archive is pruned after a verified upload" if not local
            else "%d kept in %s — expected only if an upload failed"
                 % (local, data.get("staging") or "the staging folder"))

        sources = data.get("conf_sources") or []
        self.r_conf.set_subtitle(", ".join(sources) if sources
                                 else "built-in defaults only — nothing is configured")

        self.r_cipher.set_subtitle(data.get("cipher") or "not reported")
        fpr = data.get("key_fpr") or ""
        self.r_key.set_subtitle("%s — %s" % (
            data.get("keytype") or "not reported",
            (fpr[:24] + "…") if len(fpr) > 24 else (fpr or "fingerprint missing")))

        # Only claim what was actually proven. This used to assert a specific three-way escrow
        # on the strength of any drill passing — including one that read the key off the very
        # machine whose loss the escrow exists to survive.
        if data.get("escrow_confirmed"):
            self.r_escrow.set_subtitle("Marked as escrowed after a passing drill. Check that your "
                                       "off-machine copies are still where you think they are.")
            self._set_pill(self.p_escrow, "CONFIRMED", "success")
        else:
            self.r_escrow.set_subtitle("Not confirmed. If this key is lost the backups cannot be "
                                       "read by anyone, including you.")
            self._set_pill(self.p_escrow, "ACTION NEEDED", "warning")

        drill_last = data.get("drill_last") or ""
        self.r_drill.set_subtitle(("last: %s   " % drill_last if drill_last else "")
                                  + "next: %s" % (data.get("drill_next") or "not scheduled"))
        if "PASSED" in drill_last:
            self._set_pill(self.p_drill, "PASSED", "success")
        elif "FAILED" in drill_last:
            self._set_pill(self.p_drill, "FAILED", "error")
        else:
            self._set_pill(self.p_drill, "NEVER RUN", "warning")

    def _on_kits(self, ok, out):
        self._clear_kits()
        if not ok:
            self.kit_names = []
            detail = self._clean(out.strip().splitlines()[-1]) if out.strip() else ""
            self.kit_error.set_description(
                detail + "\n\nNothing can be restored from here until this is fixed. "
                         "Check the remote with `timecrate config`.")
            self.kit_stack.set_visible_child_name("error")
            return

        # `list --long` is "<bytes>\t<modtime>\t<name>", oldest first. Anything that does not
        # split into three is treated as a bare name so a future column cannot empty this list --
        # nothing to restore is the one thing this window must never say by accident.
        kits = []
        for line in out.splitlines():
            if not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 3:
                kits.append((parts[-1].strip(), parts[0].strip()))
            else:
                kits.append((line.strip(), ""))

        self.kit_names = list(reversed([name for name, _ in kits]))
        if not self.kit_names:
            self.kit_stack.set_visible_child_name("empty")
            return

        # deviation is measured against the chronologically PREVIOUS kit, so it is computed on
        # the oldest-first list and read back as the newest-first rows are built
        deviations = {}
        for index, (name, size) in enumerate(kits):
            if index == 0 or not size.isdigit():
                continue
            prev = kits[index - 1][1]
            if prev.isdigit() and int(prev) > 0:
                deviations[name] = (int(size) - int(prev)) / int(prev)

        sizes = dict(kits)
        for filename in self.kit_names:
            row = KitRow(filename, self._kit_display(filename), self.confirm_restore,
                         size=sizes.get(filename, ""), deviation=deviations.get(filename))
            row.set_busy(self.busy)
            self.kit_rows.append(row)
            self.kit_list.append(row)
        self.kit_stack.set_visible_child_name("list")

    def _clear_kits(self):
        child = self.kit_list.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.kit_list.remove(child)
            child = nxt
        self.kit_rows = []

    def _last_backup_text(self, value):
        if not value:
            return "none yet"
        parts = value.split()
        return ("%s  —  %s" % (self._kit_display(parts[-1]), parts[-1])
                if len(parts) > 1 else value)

    def _kit_display(self, filename):
        match = KIT_RE.search(filename)
        if not match:
            return filename
        try:
            return datetime.strptime(match.group(1),
                                     "%Y-%m-%d_%H-%M-%S").strftime("%b %-d, %Y · %H:%M")
        except ValueError:
            return filename

    def _on_close_request(self, *_args):
        if not self.busy:
            return False
        dialog = Adw.AlertDialog(
            heading="Something is still running",
            body="%s, with administrator privileges. Closing this window leaves it running with "
                 "nothing watching it — and if it is a restore, mid-write. Wait for it to finish."
                 % self._operation_name())
        dialog.add_response("wait", "Keep Waiting")
        dialog.add_response("close", "Close Anyway")
        dialog.set_response_appearance("close", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("wait")
        dialog.set_close_response("wait")
        dialog.connect("response", lambda _d, resp: self.destroy() if resp == "close" else None)
        dialog.present(self)
        return True


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        (self.props.active_window or Window(self)).present()


if __name__ == "__main__":
    import sys

    App().run(sys.argv)
