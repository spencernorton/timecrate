    def _load_alerts(self):
        def done(ok, out):
            if not ok:
                self.alert_row.set_subtitle("could not check")
                return
            try:
                d = json.loads(out)
            except ValueError:
                return
            if not d.get("readable"):
                # the command may be set in a root-only file, so an unprivileged read cannot tell
                self.alert_row.set_subtitle(
                    "cannot tell from here — it may be set in %s, which only root can read"
                    % (d.get("secrets_file") or "the secrets file"))
            elif d.get("configured") is True:
                # what a FAILURE runs, which is the thing worth showing
                self.alert_row.set_subtitle(
                    "configured — a failure runs %s (%s)"
                    % (d.get("command") or "?", d.get("severity") or "?"))
            else:
                self.alert_row.set_subtitle(
                    "journal only — a failure is written to the system journal and sent nowhere else")

        run_async([TC, "alerts", "--json"], done)

    def _test_alert(self):
        dialog = Adw.AlertDialog(
            heading="Send a test alert?",
            body="This sends a real message down the same path a failed backup would use, so you "
                 "find out now rather than during an outage.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("send", "Send it")
        dialog.set_response_appearance("send", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: self.window.queue_privileged(
            ["alerts", "test"], on_finished=self._load_alerts) if r == "send" else None)
        dialog.present(self)

    def _entry(self, group, title, value, tooltip):
        row = Adw.EntryRow(title=title)
        row.set_text(str(value or ""))
        if tooltip:
            row.set_tooltip_text(tooltip)
        group.add(row)
        return row

    def _spin(self, group, title, value, low, high, subtitle=None):
        row = Adw.SpinRow.new_with_range(low, high, 1)
        row.set_title(title)
        if subtitle:
            row.set_subtitle(subtitle)
        try:
            row.set_value(float(value))
        except (TypeError, ValueError):
            pass
        group.add(row)
        return row

    def _load_schedule(self):
        def done(ok, out):
            if not ok:
                self.schedule_note.set_title("Could not read the current schedule")
                self.schedule_note.set_subtitle(
                    out.strip().splitlines()[-1] if out.strip() else "")
                return
            self.schedule_note.set_title("Currently")
            self.schedule_note.set_subtitle(out.strip())
            # `schedule` prints: "  <unit> <enabled|disabled> <OnCalendar…> next: <when>"
            for line in out.splitlines():
                parts = line.split()
                if len(parts) < 2 or parts[0] not in self.schedule_rows:
                    continue
                row, choices = self.schedule_rows[parts[0]]
                if parts[1] != "enabled":
                    row.set_selected(0)
                    continue
                calendar = " ".join(parts[2:]).split("next:")[0].strip()
                for i, (value, _label) in enumerate(choices):
                    if same_calendar(value, calendar):
                        row.set_selected(i + 1)
                        break
                else:
                    # Enabled on a calendar this window does not offer. Showing the first preset
                    # here would state a schedule that is not the one running — `*-*-* 04:00:00`
                    # displayed as "Daily" is the same misreporting this dialog exists to end.
                    # Add the real value as its own option instead, so it is shown truthfully and
                    # round-trips unchanged if the dialog is closed without touching it.
                    choices.append((calendar, "Custom — %s" % calendar))
                    row.get_model().append("Custom — %s" % calendar)
                    row.set_selected(len(choices))
            self._schedule_baseline = {u: r.get_selected() for u, (r, _c) in self.schedule_rows.items()}

        run_async([TC, "schedule"], done)

    def _read_rows(self):
        values = {}
        for name, _key in SETTINGS:
            row = self.rows[name]
            values[name] = row.get_text().strip() if name in TEXT_SETTINGS else int(row.get_value())
        return values

    def _save(self):
        values = self._read_rows()
        if values["TIMECRATE_MIN_MB"] >= values["TIMECRATE_MAX_MB"]:
            self.window.report("Not saved: the size floor must be below the cap "
                               "(%s is not below %s)." % (values["TIMECRATE_MIN_MB"],
                                                          values["TIMECRATE_MAX_MB"]))
            return
        # ONLY what actually changed. Writing every row on close means this dialog re-asserts
        # values it read when it opened, so anything altered elsewhere in the meantime gets
        # stamped back over — which is exactly how closing the window used to undo a folder
        # change made on the Remote page. Removing that setting fixed the instance; writing only
        # the differences removes the whole class.
        changed = {k: v for k, v in values.items() if v != self._baseline.get(k)}
        if not changed:
            return
        try:
            path = write_user_config(changed)
        except OSError as exc:
            self.window.report("Could not save settings: %s" % exc)
            return
        self._baseline = values
        self.window.log_line("settings written to %s: %s" % (path, ", ".join(sorted(changed))))
        self.window.toast("Settings saved")

        # Timers are root-owned, so only send the ones actually changed: closing this dialog
        # without touching the schedule must never raise an authentication prompt.
        for unit, (row, choices) in self.schedule_rows.items():
            selected = row.get_selected()
            if not self._schedule_baseline or selected == self._schedule_baseline.get(unit):
                continue
            if selected == 0:
                self.window.queue_privileged(["schedule", unit, "off"])
            else:
                self.window.queue_privileged(
                    ["schedule", unit, "on", "--at", choices[selected - 1][0]])
        self.window.refresh()


class ImportKeyDialog(Adw.Dialog):
    """Bring an escrowed key onto a rebuilt machine.

    Two steps on purpose. `import-key --dry-run` validates the file and reports the fingerprint
    without writing anything, so the operator confirms WHICH key they are about to trust before it
    is trusted. Doing it in one step would mean either importing blind or asking the CLI's own
    prompt, which reads /dev/tty and there is no tty here.
    """

    def __init__(self, window, on_done):
        super().__init__(title="Import an escrowed key", content_width=560)
        self.window, self.on_done = window, on_done
        self.key_path = None
        self.signing_path = None
        self._temp = None

        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(
            description="The secret key from your escrow — a file, or the armored text from the "
                        "printed recovery sheet. It starts with BEGIN PGP PRIVATE KEY BLOCK.")
        page.add(group)

        self.file_row = Adw.ActionRow(title="Key file", subtitle="none chosen")
        self.file_row.set_subtitle_selectable(True)
        pick = Gtk.Button(label="Choose…", valign=Gtk.Align.CENTER)
        pick.connect("clicked", lambda *_: self._choose("key"))
        self.file_row.add_suffix(pick)
        group.add(self.file_row)

        self.sign_row = Adw.ActionRow(
            title="Signing public key",
            subtitle="optional — without it a restore can decrypt but not authenticate")
        self.sign_row.set_subtitle_selectable(True)
        pick2 = Gtk.Button(label="Choose…", valign=Gtk.Align.CENTER)
        pick2.connect("clicked", lambda *_: self._choose("signing"))
        self.sign_row.add_suffix(pick2)
        group.add(self.sign_row)

        paste = Adw.PreferencesGroup(title="…or paste it")
        page.add(paste)
        self.textview = Gtk.TextView(monospace=True, wrap_mode=Gtk.WrapMode.CHAR)
        scroll = Gtk.ScrolledWindow(min_content_height=160)
        scroll.set_child(self.textview)
        scroll.add_css_class("card")
        paste.add(scroll)

        self.check = Gtk.Button(label="Check this key")
        self.check.add_css_class("suggested-action")
        self.check.connect("clicked", lambda *_: self._validate())
        box = Gtk.Box(halign=Gtk.Align.END, spacing=8)
        box.append(self.check)
        paste.add(box)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.set_child(view)

    def _choose(self, which):
        dialog = Gtk.FileDialog()
        dialog.set_title("Signing public key" if which == "signing" else "Escrowed secret key")

        def picked(source, result):
            try:
                path = source.open_finish(result).get_path()
            except GLib.Error:
                return                      # cancelled — not an error worth reporting
            if which == "signing":
                self.signing_path = path
                self.sign_row.set_subtitle(path)
            else:
                self.key_path = path
                self.file_row.set_subtitle(path)

        dialog.open(self.window, None, picked)

    def _source_path(self):
        """The chosen file, or the pasted text written to a private temp file."""
        if self.key_path:
            return self.key_path
        buf = self.textview.get_buffer()
        text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
        if not text:
            return None
        fd, path = tempfile.mkstemp(prefix="timecrate-import-", suffix=".asc")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text + "\n")
        self._temp = path
        return path

    def _cleanup(self):
        if self._temp:
            try:
                os.unlink(self._temp)
            except OSError:
                pass
            self._temp = None

    def _validate(self):
        path = self._source_path()
        if not path:
            self.window.report("Choose a key file, or paste the armored key text.")
            return
        self.check.set_sensitive(False)

        def done(ok, out):
            self.check.set_sensitive(True)
            if not ok:
                self._cleanup()
                # the CLI's refusals name the reason (public-only, non-RSA, expired); show it
                self.window.report(self.window._clean(out.strip().splitlines()[-1])
                                   if out.strip() else "Could not read that key.")
                return
            fpr = ""
            for line in out.splitlines():
                if FPR_RE.match(line.strip()):
                    fpr = line.strip()
                    break
            if not fpr:
                self._cleanup()
                self.window.report("The key validated but reported no fingerprint.")
                return
            self._confirm(path, fpr)

        run_async([TC, "import-key", path, "--dry-run"], done)

    def _confirm(self, path, fpr):
        pretty = " ".join(fpr[i:i + 4] for i in range(0, len(fpr), 4)) or "(unknown)"
        dialog = Adw.AlertDialog(
            heading="Import this key?",
            body="Fingerprint\n%s\n\nCheck it against your escrow sheet. Backups made from now "
                 "on will be encrypted to this key." % pretty)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("import", "Import")
        dialog.set_response_appearance("import", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("import")
        dialog.set_close_response("cancel")

        def answered(_d, response):
            if response != "import":
                self._cleanup()
                return
            args = [TC, "import-key", path, "--yes"]
            if self.signing_path:
                args += ["--signing-pub", self.signing_path]

            def done(ok, out):
                self._cleanup()
                last = out.strip().splitlines()[-1] if out.strip() else ""
                if ok:
                    self.window.toast("Key imported")
                    self.window.log_line("imported key %s" % fpr)
                    self.close()
                    self.on_done()
                else:
                    self.window.report(self.window._clean(last) or "Import failed.")

            run_async(args, done)

        dialog.connect("response", answered)
        dialog.present(self)


class FolderPicker(Adw.Dialog):
    """Walk the remote and choose a folder, instead of typing a path and hoping.

    Every listing comes from `remote browse`, so this cannot show anything the command line
    cannot. Choosing a folder does NOT commit: `set-path --dry-run` reports the backup count at
    both ends first, because repointing away from a path that holds backups is how they become
    invisible without anything being deleted.
    """

    def __init__(self, window, start, on_chosen):
        super().__init__(title="Choose a folder", content_width=560, content_height=520)
        self.window, self.on_chosen = window, on_chosen
        self.path = start or ""
        # Listings are async, so a fast enter-then-up leaves two in flight. Without this the
        # slower reply appends its folders under the other folder's title, and clicking one builds
        # a path relative to a directory it was never in.
        self._seq = 0

        self.header = Adw.HeaderBar()
        self.up_button = Gtk.Button(icon_name="go-up-symbolic")
        self.up_button.set_tooltip_text("Up one level")
        self.up_button.connect("clicked", lambda *_: self._up())
        self.header.pack_start(self.up_button)
        new_button = Gtk.Button(icon_name="folder-new-symbolic")
        new_button.set_tooltip_text("New folder here")
        new_button.connect("clicked", lambda *_: self._new_folder())
        self.header.pack_end(new_button)

        self.page = Adw.PreferencesPage()
        self.group = Adw.PreferencesGroup()
        self.page.add(self.group)

        self.choose = Gtk.Button(label="Use this folder")
        self.choose.add_css_class("suggested-action")
        self.choose.connect("clicked", lambda *_: self._confirm())
        bar = Gtk.Box(halign=Gtk.Align.CENTER, spacing=8, margin_top=6, margin_bottom=12)
        bar.append(self.choose)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.page)
        box.append(bar)
        view = Adw.ToolbarView()
        view.add_top_bar(self.header)
        view.set_content(box)
        self.set_child(view)
        self._load()

    def _remote_name(self):
        return self.path.split(":", 1)[0] if ":" in self.path else self.path

    def _up(self):
        name, _, rest = self.path.partition(":")
        rest = rest.rstrip("/")
        if "/" in rest:
            self.path = "%s:%s" % (name, rest.rsplit("/", 1)[0])
        else:
            self.path = "%s:" % name
        self._load()

    def _load(self):
        self.group.set_title(self.path or "(no remote)")
        for row in list(self.rows()):
            self.group.remove(row)
        self.up_button.set_sensitive(":" in self.path and self.path.split(":", 1)[1].strip("/") != "")

        self._seq += 1
        seq = self._seq

        def done(ok, out):
            if seq != self._seq:
                return                      # a later navigation already superseded this one
            if not ok:
                row = Adw.ActionRow(title="Could not list this folder",
                                    subtitle=self.window._clean(out.strip().splitlines()[-1])
                                    if out.strip() else "")
                self.group.add(row)
                return
            try:
                names = json.loads(out)
            except ValueError:
                names = []
            if not names:
                self.group.add(Adw.ActionRow(title="No folders here",
                                             subtitle="You can still choose this one."))
                return
            for name in names:
                row = Adw.ActionRow(title=name, activatable=True)
                row.add_prefix(Gtk.Image.new_from_icon_name("folder-symbolic"))
                row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
                row.connect("activated", lambda _r, n=name: self._enter(n))
                self.group.add(row)

        run_async([TC, "remote", "browse", self.path, "--json"], done)

    def rows(self):
        child = self.group.get_first_child()
        found = []
        # Adw.PreferencesGroup wraps its children; walk for ActionRows rather than assume a shape
        def walk(w):
            while w is not None:
                if isinstance(w, Adw.ActionRow):
                    found.append(w)
                walk(w.get_first_child())
                w = w.get_next_sibling()
        walk(child)
        return found

    def _enter(self, name):
        base = self.path if self.path.endswith(":") else self.path.rstrip("/") + "/"
        self.path = base + name
        self._load()

    def _new_folder(self):
        dialog = Adw.AlertDialog(heading="New folder",
                                 body="Created under %s." % self.path)
        entry = Gtk.Entry(placeholder_text="Folder name")
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("create", "Create")
        dialog.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("create")

        def answered(_d, response):
            name = entry.get_text().strip()
            if response != "create" or not name:
                return
            base = self.path if self.path.endswith(":") else self.path.rstrip("/") + "/"

            def done(ok, out):
                if ok:
                    self._load()
                else:
                    self.window.report(self.window._clean(
                        out.strip().splitlines()[-1] if out.strip() else "") or "Could not create it.")

            run_async([TC, "remote", "mkdir", base + name], done)

        dialog.connect("response", answered)
        dialog.present(self)

    def _confirm(self):
        """Ask the engine what this move would cost before doing it."""
        target = self.path
        self.choose.set_sensitive(False)

        def done(ok, out):
            self.choose.set_sensitive(True)
            body = "\n".join(self.window._clean(l) for l in out.strip().splitlines()
                             if l.strip() and "DRY RUN" not in l)
            if not ok:
                self.window.report(body.splitlines()[-1] if body else "Could not check that folder.")
                return
            dialog = Adw.AlertDialog(heading="Use %s?" % target, body=body or
                                     "Future backups will be written here.")
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("use", "Use this folder")
            dialog.set_response_appearance("use", Adw.ResponseAppearance.SUGGESTED)
            dialog.set_close_response("cancel")

            def answered(_d, response):
                if response != "use":
                    return

                def committed(ok2, out2):
                    if ok2:
                        self.window.toast("Backups will now go to %s" % target)
                        self.close()
                        self.on_chosen()
                    else:
                        self.window.report(self.window._clean(
                            out2.strip().splitlines()[-1] if out2.strip() else "") or "Failed.")

                run_async([TC, "remote", "set-path", target, "--yes"], committed)

            dialog.connect("response", answered)
            dialog.present(self)

        run_async([TC, "remote", "set-path", target, "--dry-run"], done)


class CoverageDialog(Adw.Dialog):
    """What is skipped, not just what is kept.

    The include list is an allowlist, so anything unnamed is absent from every kit — and nothing in
    this window used to say so. A real audit found /usr/local missing entirely (software no package
    can recreate) and thirty-plus uncovered settings directories, on a machine whose backups had
    reported success nightly for weeks. The gap was only visible to someone who walked the
    filesystem by hand and compared it against the list.

    Ordered worst-first on purpose: the actionable rows are the ones nothing covers.
    """

    GROUPS = [
        ("UNLISTED", "Not backed up",
         "Nothing in the include list covers these, so they are in no kit. This is the list to read."),
        ("partial", "Partly backed up",
         "Some of the tree is included; the rest is not."),
        ("included", "Backed up", "Covered by the include list."),
        ("excluded", "Deliberately excluded", "Matched by an exclude rule, shown alongside."),
    ]

    def __init__(self, window):
        super().__init__(title="Coverage", content_width=760, content_height=640)
        self.window = window
        self.page = Adw.PreferencesPage()
        self.banner = Adw.PreferencesGroup(
            description="Reading the filesystem and comparing it against the include and exclude "
                        "lists. Sizing large directories takes a moment.")
        self.page.add(self.banner)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(self.page)
        self.set_child(view)
        self.reload()

    def reload(self):
        def done(ok, out):
            for g in list(self._groups()):
                self.page.remove(g)
            if not ok:
                self.page.add(Adw.PreferencesGroup(
                    description="Could not read coverage: " + (out or "no output").strip()[:400]))
                return
            try:
                data = json.loads(out)
            except Exception as exc:
                self.page.add(Adw.PreferencesGroup(description="Unreadable coverage output: %s" % exc))
                return
            entries = data.get("entries", [])
            over = data.get("unlisted_over_warn", [])
            warn_mb = data.get("warn_mb", 100)
            if over:
                head = Adw.PreferencesGroup()
                row = Adw.ActionRow(
                    title="%d %s over %sMB are in no kit"
                          % (len(over), "directory is" if len(over) == 1 else "directories are", warn_mb),
                    subtitle="Largest: " + ", ".join(
                        "%s (%s)" % (e["path"].rsplit("/", 1)[-1], human_bytes(e["kb"] * 1024))
                        for e in over[:3]))
                row.add_prefix(Gtk.Image.new_from_icon_name("dialog-warning-symbolic"))
                row.add_css_class("error")
                head.add(row)
                self.page.add(head)
            for state, title, subtitle in self.GROUPS:
                rows = [e for e in entries if e["state"] == state]
                if not rows:
                    continue
                group = Adw.PreferencesGroup(title="%s  (%d)" % (title, len(rows)), description=subtitle)
                # Capped deliberately, and the cap is stated rather than silently truncating —
                # a list that quietly stops is how you conclude there is nothing more to see.
                for e in rows[:60]:
                    r = Adw.ActionRow(title="/" + e["path"],
                                      subtitle=(e["rule"] if e["rule"] and e["rule"] != "-" else ""))
                    r.set_subtitle_selectable(True)
                    r.add_suffix(Gtk.Label(label=human_bytes(e["kb"] * 1024) if e["kb"] else "",
                                           valign=Gtk.Align.CENTER))
                    group.add(r)
                if len(rows) > 60:
                    group.add(Adw.ActionRow(title="… and %d more not shown" % (len(rows) - 60)))
                self.page.add(group)

        run_async([TC, "coverage", "--json"], done)

    def _groups(self):
        out, w = [], self.page.get_first_child()

        def walk(w):
            while w is not None:
                if isinstance(w, Adw.PreferencesGroup) and w is not self.banner:
                    out.append(w)
                walk(w.get_first_child())
                w = w.get_next_sibling()

        walk(w)
        return out


class PathsEditor(Adw.Dialog):
    """Edit an include/exclude list in place.

    These files live in /etc and are root-owned, so the old buttons could only OPEN them — the
    editor came up read-only and saving failed. Every change here goes through the same pkexec'd
    binary as backup and restore, which means one authentication per change: they are conffiles
    describing what a backup contains, and the policy for this tool is auth_admin every time
    rather than a grace window.
    """

    LABELS = {"include": ("What gets backed up",
                          "Paths that make up a kit. Directories are included whole; the exclude "
                          "list prunes inside them."),
              "exclude": ("What is left out",
                          "Pruned from inside the included paths — caches, bulk data, anything "
                          "reproducible.")}

    def __init__(self, window, which, on_done):
        title, subtitle = self.LABELS[which]
        super().__init__(title=title, content_width=620, content_height=560)
        self.window, self.which, self.on_done = window, which, on_done

        page = Adw.PreferencesPage()
        self.group = Adw.PreferencesGroup(description=subtitle)
        page.add(self.group)

        add = Adw.PreferencesGroup(title="Add a path")
        page.add(add)
        self.entry = Adw.EntryRow(title="Path")
        pick = Gtk.Button(icon_name="folder-open-symbolic", valign=Gtk.Align.CENTER)
        pick.set_tooltip_text("Choose a folder")
        pick.connect("clicked", lambda *_: self._choose())
        self.entry.add_suffix(pick)
        add.add(self.entry)
        self.add_button = Gtk.Button(label="Add")
        self.add_button.add_css_class("suggested-action")
        self.add_button.connect("clicked", lambda *_: self._add())
        bar = Gtk.Box(halign=Gtk.Align.END, spacing=8, margin_end=12, margin_bottom=8)
        bar.append(self.add_button)
        add.add(bar)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.set_child(view)
        self.reload()

    def rows(self):
        found = []

        def walk(w):
            while w is not None:
                if isinstance(w, Adw.ActionRow):
                    found.append(w)
                walk(w.get_first_child())
                w = w.get_next_sibling()

        walk(self.group.get_first_child())
        return found

    def reload(self):
        for row in self.rows():
            self.group.remove(row)

        def done(ok, out):
            if not ok:
                self.group.add(Adw.ActionRow(
                    title="Could not read the list",
                    subtitle=self.window._clean(out.strip().splitlines()[-1]) if out.strip() else ""))
                return
            entries = [l.strip() for l in out.splitlines() if l.strip()]
            self.group.set_title("%d entr%s" % (len(entries), "y" if len(entries) == 1 else "ies"))
            for entry in entries:
                row = Adw.ActionRow(title=entry)
                row.set_title_selectable(True)
                remove = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER)
                remove.add_css_class("flat")
                remove.set_tooltip_text("Remove %s" % entry)
                remove.connect("clicked", lambda _b, e=entry: self._remove(e))
                row.add_suffix(remove)
                self.group.add(row)

        run_async([TC, "paths", self.which, "list"], done)

    def _choose(self):
        dialog = Gtk.FileDialog()
        dialog.set_title("Choose a folder to %s" % ("include" if self.which == "include" else "exclude"))

        def picked(source, result):
            try:
                path = source.select_folder_finish(result).get_path()
            except GLib.Error:
                return
            self.entry.set_text(path or "")

        dialog.select_folder(self.window, None, picked)

    def _add(self):
        # NOT .strip() on the value: a directory whose name ends in a space is a different
        # directory, and the file chooser hands those over verbatim. Trim only to decide whether
        # anything was typed at all.
        path = self.entry.get_text()
        if not path.strip():
            self.window.report("Type a path, or choose a folder.")
            return
        self.entry.set_text("")
        self.window.queue_privileged(["paths", self.which, "add", path], on_finished=self._after)

    def _remove(self, entry):
        dialog = Adw.AlertDialog(
            heading="Remove this entry?",
            body="%s\n\nThe files are not touched — they just stop being part of a backup."
                 % entry if self.which == "include" else
                 "%s\n\nIt will start being included again." % entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: self.window.queue_privileged(
            ["paths", self.which, "remove", entry], on_finished=self._after) if r == "remove" else None)
        dialog.present(self)

    def _after(self):
        self.reload()
        self.on_done()


class RemotePage(Adw.PreferencesPage):
