    def reload(self):
        def done(ok, out):
            if not ok:
                self.r_path.set_subtitle("could not read the remote configuration")
                self.window._set_pill(self.p_reach, "UNKNOWN", "error")
                return
            try:
                self.info = json.loads(out)
            except ValueError:
                return
            self._render()

        run_async([TC, "remote", "status", "--json"], done)

    def _render(self):
        d, w = self.info, self.window
        remote = d.get("remote") or ""
        self.r_path.set_subtitle(remote or "none — this machine is not pointed at a remote")
        if d.get("configured"):
            self.r_account.set_subtitle(d.get("account") or "%s (rclone remote \"%s\")"
                                        % (d.get("type", ""), d.get("name", "")))
            self.btn_connect.set_label("Re-authorise…")
        else:
            self.r_account.set_subtitle("no rclone remote called \"%s\" yet" % d.get("name", ""))
            self.btn_connect.set_label("Connect…")
        expiry = d.get("token_expiry") or ""
        if d.get("has_token"):
            self.r_token.set_subtitle(
                ("signed in — the token renews itself; the current one expires %s" % expiry[:19])
                if expiry else "signed in")
        else:
            self.r_token.set_subtitle("not signed in")
        if d.get("reachable"):
            kits = d.get("kits")
            self.r_reach.set_subtitle("%s backup(s) at this folder" % kits if kits != "" else "yes")
            w._set_pill(self.p_reach, "OK", "success")
        else:
            self.r_reach.set_subtitle("could not list it — use Test for the reason")
            w._set_pill(self.p_reach, "UNREACHABLE", "error")
        used, total = d.get("remote_quota_used", ""), d.get("remote_quota_total", "")
        self.r_quota.set_subtitle("%s of %s used" % (human_bytes(used), human_bytes(total))
                                  if total else "not reported by this provider")
        if d.get("drive_signed_in"):
            self.r_drive.set_subtitle("signed in as %s — backups can use %s:<folder>"
                                      % (d.get("drive_account") or "your Google account",
                                         d.get("drive_remote") or "gdrive"))
        elif d.get("drive_configured"):
            self.r_drive.set_subtitle("configured, but the token is not valid — sign in again")
        else:
            self.r_drive.set_subtitle("not signed in — choose Google Drive, then Sign in")
        self.btn_test.set_sensitive(bool(remote))
        self.btn_disconnect.set_sensitive(bool(remote))
        # the provider choice starts from the remote this machine actually uses, so the
        # Connect button keeps describing THAT sign-in until the user picks another
        rtype = (d.get("type") or "").lower()
        self.provider_row.set_selected(
            0 if rtype == "drive" or not d.get("configured") else 1)
        self._provider_changed()

    # ---------- actions ----------

    def _browse(self):
        start = self.info.get("remote") or ""
        FolderPicker(self.window, start, self._after_change).present(self.window)

    def _after_change(self):
        self.reload()
        self.window.refresh()

    def _provider_changed(self):
        if self.provider_row.get_selected() == 0:      # Google Drive
            self.btn_connect.set_label(
                "Re-authorise Google…" if self.info.get("drive_signed_in")
                else "Sign in with Google…")
        else:                                          # Dropbox (the historical default)
            self.btn_connect.set_label(
                "Re-authorise…" if self.info.get("configured") else "Connect…")

    def _connect(self):
        drive = self.provider_row.get_selected() == 0
        argv = ([TC, "remote", "connect", "--provider", "drive"] if drive
                else [TC, "remote", "connect"])
        self.btn_connect.set_sensitive(False)
        self.window.log_line("$ " + " ".join(argv[1:]))
        self.window.toast("Finish the sign-in in your browser")

        def done(ok, out):
            self.btn_connect.set_sensitive(True)
            last = [l for l in out.strip().splitlines() if l.strip()]
            msg = self.window._clean(last[-1]) if last else ""
            self.window.log_line(msg)
            if ok:
                self.window.toast("Connected")
                self._after_change()
                if drive:
                    # Signed in: the next decision is which folder, so open the picker there.
                    FolderPicker(self.window,
                                 "%s:" % (self.info.get("drive_remote") or "gdrive"),
                                 self._after_change).present(self.window)
            else:
                self.window.report(msg or "Could not connect.")

        run_async(argv, done)

    def _test(self):
        self.btn_test.set_sensitive(False)
        self.window.log_line("$ timecrate remote test")

        def done(ok, out):
            self.btn_test.set_sensitive(True)
            last = [l for l in out.strip().splitlines() if l.strip()]
            msg = self.window._clean(last[-1]) if last else ""
            self.window.log_line(msg)
            # the engine already distinguishes missing path / bad token / read-only, so show
            # exactly what it said rather than a generic failure
            self.window.toast("Remote OK — lists and accepts writes") if ok else self.window.report(msg)
            self.reload()

        run_async([TC, "remote", "test"], done)

    def _disconnect(self):
        dialog = Adw.AlertDialog(
            heading="Forget this remote?",
            body="This machine will stop using %s.\n\nYour backups are NOT deleted, and this does "
                 "not revoke access at the provider — do that in their settings if you meant to."
                 % (self.info.get("remote") or "it"))
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("forget", "Forget it")
        dialog.set_response_appearance("forget", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_close_response("cancel")

        def answered(_d, response):
            if response != "forget":
                return

            def done(ok, out):
                if ok:
                    self.window.toast("Remote forgotten")
                    self._after_change()
                else:
                    self.window.report(self.window._clean(
                        out.strip().splitlines()[-1] if out.strip() else "") or "Failed.")

            run_async([TC, "remote", "disconnect", "--yes"], done)

        dialog.connect("response", answered)
        dialog.present(self.window)


class KeysPage(Adw.PreferencesPage):
    """The key that decrypts the backups: what exists, whether it is here, whether it is escrowed.

    Nothing on this page goes through pkexec except escrow-confirm. The keyring belongs to the
    configured user, so running these as root would put it in /root/.config, where the timers
    would never look for it.
    """

    def __init__(self, window):
        super().__init__(title="Keys", icon_name="dialog-password-symbolic")
        self.window = window
        self.keys = {}

        ident = Adw.PreferencesGroup(
            title="Identity",
            description="The secret key is the only thing that can decrypt your backups, and it "
                        "is deliberately not inside them. Lose it and they are lost with it.")
        self.add(ident)
        self.r_enc, self.p_enc = self._pill(ident, "Encryption key", "channel-secure-symbolic")
        self.r_sign = self._row(ident, "Signing key", "emblem-ok-symbolic")
        self.r_escrow, self.p_escrow = self._pill(ident, "Escrow", "security-high-symbolic")
        self.r_pq, self.p_pq = self._pill(ident, "Post-quantum key", "channel-secure-symbolic")

        crypto = Adw.PreferencesGroup(
            title="Encryption",
            description="Hybrid wraps each new backup in an ML-KEM-1024 post-quantum envelope "
                        "around the same signed GPG kit; opening one needs both secret keys, "
                        "and both are on the recovery sheet. Backups already made stay readable "
                        "either way.")
        self.add(crypto)
        self.crypto_row = Adw.ComboRow(
            title="Encryption algorithm",
            subtitle="Applies to new backups; change it any time")
        crypto_model = Gtk.StringList()
        crypto_model.append("Classic — RSA-4096 + AES-256")
        crypto_model.append("Hybrid — ML-KEM-1024 + RSA-4096 (post-quantum)")
        self.crypto_row.set_model(crypto_model)
        self.crypto_row.set_selected(0)
        self._crypto_guard = False
        self.crypto_row.connect("notify::selected", lambda *_: self._crypto_changed())
        crypto.add(self.crypto_row)
        self.btn_pq = self._action(
            crypto, "Post-quantum key",
            "Hybrid backups wrap to this ML-KEM-1024 key. Generate it once, then download a "
            "fresh recovery sheet — the sheet is its escrow.", "Generate", self._pq_init)

        act = Adw.PreferencesGroup(
            title="Recovery",
            description="Everything here works without administrator rights, except confirming "
                        "the escrow.")
        self.add(act)
        self.btn_import = self._action(
            act, "Import an escrowed key",
            "Put an existing identity back on this machine. Shows you the fingerprint before it "
            "trusts anything.", "Import…", self._import)
        self.btn_verify = self._action(
            act, "Check this machine can read the backups",
            "Reads the newest archive on the remote and confirms it is encrypted to a key held "
            "here. The recovery drill proves the escrowed copy works; this proves this one does.",
            "Check", self._verify)
        self.btn_export = self._action(
            act, "Export the key for escrow",
            "Write the secret key out so you can move it somewhere this machine is not. Refuses "
            "any location that would end up inside a backup.", "Export…", self._export)
        self.btn_sheet = self._action(
            act, "Recovery sheet (TXT)", "A printable plain-text page with the keys (GPG and, "
            "when present, the post-quantum key) and the steps to use them.",
            "Write…", self._sheet)
        self.btn_sheet_pdf = self._action(
            act, "Recovery sheet (PDF)", "The same sheet as a printable PDF, for download and "
            "storage with your other recovery documents.", "Write PDF…", self._sheet_pdf)
        self.btn_confirm = self._action(
            act, "Mark the key as escrowed",
            "Records that a copy exists off this machine, and which key it is. Needs "
            "administrator approval.", "Confirm", self._confirm_escrow)

        # `harden` is reported here, deliberately not offered. It is the one irreversible act in
        # the tool, and its safety check is an interactive off-box comparison that a subprocess
        # with no terminal cannot carry out, so a button could only skip that check.
        self.hint = Adw.ActionRow(title="", subtitle="")
        self.hint.set_subtitle_selectable(True)
        self.hint.set_visible(False)
        act.add(self.hint)

        self.reload()

    # ---------- construction helpers ----------

    def _row(self, group, title, icon):
        row = Adw.ActionRow(title=title, subtitle="…")
        row.add_prefix(Gtk.Image.new_from_icon_name(icon))
        row.set_subtitle_selectable(True)
        group.add(row)
        return row

    def _pill(self, group, title, icon):
        row = self._row(group, title, icon)
        pill = Gtk.Label(label="…", valign=Gtk.Align.CENTER)
        pill.add_css_class("pill")
        pill.add_css_class("neutral")
        row.add_suffix(pill)
        return row, pill

    def _action(self, group, title, subtitle, label, fn):
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        button = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
        button.connect("clicked", lambda *_: fn())
        row.add_suffix(button)
        group.add(row)
        return button

    # ---------- state ----------

    def reload(self):
        def done(ok, out):
            if not ok:
                self.r_enc.set_subtitle("could not read the keyring")
                self.window._set_pill(self.p_enc, "UNKNOWN", "error")
                return
            try:
                self.keys = json.loads(out)
            except ValueError:
                self.r_enc.set_subtitle("unreadable output from `timecrate keys`")
                return
            self._render()

        run_async([TC, "keys", "--json"], done)

    def _render(self):
        k = self.keys
        fpr = k.get("encryption_fpr") or ""
        w = self.window
        if not fpr and not k.get("keyring_readable", True):
            self.r_enc.set_subtitle(
                "cannot be read by this account — %s is owned by %s"
                % (k.get("config_dir") or "the key store", k.get("keyring_owner") or "another user"))
            w._set_pill(self.p_enc, "UNREADABLE", "error")
            self.r_sign.set_subtitle("unknown while the key store is unreadable")
            self.r_escrow.set_subtitle("unknown while the key store is unreadable")
            self.r_pq.set_subtitle("unknown while the key store is unreadable")
            w._set_pill(self.p_escrow, "UNKNOWN", "warning")
            for b in (self.btn_export, self.btn_verify, self.btn_import):
                b.set_sensitive(False)
            self.hint.set_title("The key store is not readable by this account")
            self.hint.set_subtitle(
                "This is what an `init` run under sudo leaves behind: the keyring lives in your "
                "home but belongs to root. Until that is fixed this window cannot report or "
                "change anything about the key. `sudo timecrate keys` can still read it.")
            self.hint.set_visible(True)
            return
        if not fpr:
            self.r_enc.set_subtitle("none — this machine cannot back up or restore yet")
            w._set_pill(self.p_enc, "MISSING", "error")
        elif k.get("encryption_secret_present"):
            self.r_enc.set_subtitle(fpr)
            w._set_pill(self.p_enc, "CAN DECRYPT", "success")
        else:
            self.r_enc.set_subtitle(fpr)
            # not an error: this is what `harden` is for. But it does mean no restore from here.
            w._set_pill(self.p_enc, "ENCRYPT ONLY", "warning")

        sfpr = k.get("signing_fpr") or ""
        if not sfpr:
            self.r_sign.set_subtitle("none — archives from this machine would be unsigned")
        elif k.get("signing_public_present"):
            self.r_sign.set_subtitle("%s — signatures can be verified here" % sfpr)
        else:
            self.r_sign.set_subtitle("%s — public half MISSING, so restores here cannot "
                                     "authenticate an archive" % sfpr)

        state = k.get("escrow_state", "none")
        if state == "confirmed" and k.get("escrow_fpr") == fpr:
            self.r_escrow.set_subtitle("confirmed %s for this key" % (k.get("escrow_when") or ""))
            w._set_pill(self.p_escrow, "CONFIRMED", "success")
        elif state == "confirmed":
            self.r_escrow.set_subtitle(
                "confirmed for %s, which is not the key in use" % (k.get("escrow_fpr") or "?"))
            w._set_pill(self.p_escrow, "STALE", "error")
        elif state == "unknown":
            self.r_escrow.set_subtitle(
                "confirmed by an older version that did not record which key or when")
            w._set_pill(self.p_escrow, "UNVERIFIED", "warning")
        else:
            self.r_escrow.set_subtitle("no copy of this key is known to exist off this machine")
            w._set_pill(self.p_escrow, "ACTION NEEDED", "error")

        pqfpr = k.get("pq_fpr") or ""
        if pqfpr and k.get("pq_secret_present"):
            self.r_pq.set_subtitle("%s… — ML-KEM-1024, secret on this box" % pqfpr[:16])
            w._set_pill(self.p_pq, "READY", "success")
        elif pqfpr:
            self.r_pq.set_subtitle("%s… — public key only; the secret is escrow-only" % pqfpr[:16])
            w._set_pill(self.p_pq, "ESCROW ONLY", "warning")
        else:
            self.r_pq.set_subtitle("none — hybrid backups need one (Encryption section)")
            w._set_pill(self.p_pq, "NOT SET UP", "warning")
        self.btn_pq.set_sensitive(not pqfpr)
        self._crypto_guard = True
        self.crypto_row.set_selected(1 if k.get("crypto") == "hybrid" else 0)
        self._crypto_guard = False

        self.btn_export.set_sensitive(bool(k.get("encryption_secret_present")))
        self.btn_verify.set_sensitive(bool(fpr))
        if fpr and not k.get("encryption_secret_present"):
            self.hint.set_title("This machine is encrypt-only")
            self.hint.set_subtitle(
                "The secret key was removed by `harden`, or was never imported. Restoring here "
                "needs the escrowed copy — import it above.")
            self.hint.set_visible(True)
        else:
            self.hint.set_visible(False)

    # ---------- actions ----------

    def _import(self):
        ImportKeyDialog(self.window, self._after_change).present(self.window)

    def _after_change(self):
        self.reload()
        self.window.refresh()

    def _verify(self):
        self.btn_verify.set_sensitive(False)
        self.window.log_line("$ timecrate verify-key")

        def done(ok, out):
            self.btn_verify.set_sensitive(True)
            last = [l for l in out.strip().splitlines() if l.strip()]
            msg = self.window._clean(last[-1]) if last else ""
            if ok:
                self.window.toast("This machine can read the backups")
            else:
                self.window.report(msg or "Could not check the key.")
            self.window.log_line(msg)

        run_async([TC, "verify-key"], done)

    def _export(self):
        dialog = Gtk.FileDialog()
        dialog.set_title("Export the secret key")
        dialog.set_initial_name("timecrate-secret.asc")

        def picked(source, result):
            try:
                path = source.save_finish(result).get_path()
            except GLib.Error:
                return

            def done(ok, out):
                last = out.strip().splitlines()[-1] if out.strip() else ""
                if ok:
                    self.window.toast("Key exported — now move it off this machine")
                    self.window.log_line("exported the secret key to %s" % path)
                else:
                    self.window.report(self.window._clean(last) or "Export failed.")

            run_async([TC, "export-key", "--out", path], done)

        dialog.save(self.window, None, picked)

    def _sheet(self):
        self._sheet_save("txt")

    def _sheet_pdf(self):
        self._sheet_save("pdf")

    def _sheet_save(self, fmt):
        dialog = Gtk.FileDialog()
        dialog.set_title("Write the recovery sheet")
        dialog.set_initial_name("timecrate-recovery-sheet.%s" % fmt)

        def picked(source, result):
            try:
                path = source.save_finish(result).get_path()
            except GLib.Error:
                return

            def done(ok, out):
                if ok:
                    self.window.toast("Recovery sheet written")
                    self.window.log_line("recovery sheet (%s) written to %s" % (fmt, path))
                else:
                    self.window.report(self.window._clean(
                        out.strip().splitlines()[-1] if out.strip() else "") or "Failed.")

            run_async([TC, "escrow-doc", "--format", fmt, path], done)

        dialog.save(self.window, None, picked)

    def _crypto_changed(self):
        if self._crypto_guard:
            return
        value = "hybrid" if self.crypto_row.get_selected() == 1 else "classic"
        try:
            path = write_user_config({"TIMECRATE_CRYPTO": value})
        except OSError as exc:
            self.window.report("Could not save the encryption setting: %s" % exc)
            return
        self.keys["crypto"] = value
        self.window.log_line("encryption algorithm set to %s (written to %s)" % (value, path))
        self.window.toast("Encryption: %s"
                          % ("Hybrid (post-quantum)" if value == "hybrid" else "Classic"))
        if value == "hybrid" and not self.keys.get("pq_fpr"):
            self.window.report(
                "Hybrid is on, but there is no post-quantum key yet — Generate one in the "
                "Encryption section, then download a fresh recovery sheet.")
        self.window.refresh()

    def _pq_init(self):
        self.btn_pq.set_sensitive(False)

        def done(ok, out):
            last = out.strip().splitlines()[-1] if out.strip() else ""
            if ok:
                self.window.toast("Post-quantum key ready — download a fresh recovery sheet")
                self.window.log_line(self.window._clean(last))
            else:
                self.window.report(self.window._clean(last) or "Could not generate the PQ key.")
            self.reload()

        run_async([TC, "pq", "init"], done)

    def _confirm_escrow(self):
        dialog = Adw.AlertDialog(
            heading="Is a copy of this key somewhere else?",
            body="Only confirm this if a copy of the secret key exists somewhere this machine "
                 "does not — a password manager, a printed sheet, a USB stick kept elsewhere. "
                 "Confirming it while no copy exists is how backups become unrecoverable.")
        dialog.add_response("cancel", "Not yet")
        dialog.add_response("confirm", "Yes, a copy exists")
        dialog.set_response_appearance("confirm", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: self.window.queue_privileged(["escrow-confirm"])
                       if r == "confirm" else None)
        dialog.present(self.window)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Timecrate",
                         default_width=860, default_height=880)
        self.busy = False
        self.current_kind = None
        self.keys = {}
        self._first_run_shown = False
        self._privileged_done = None
        self.last_error = ""
        self.warnings = []
        self.kit_names = []
        self.kit_rows = []
        self.status = {}
        self.staged_path = ""
        self.pending_privileged = []
        self._banner_handler = None

        self._install_css()

        self.overlay = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(
            Adw.WindowTitle(title="Timecrate", subtitle="Encrypted off-site backup"))

        self.refresh_button = Gtk.Button(icon_name="view-refresh-symbolic")
        self.refresh_button.set_tooltip_text("Refresh status and backups (Ctrl+R)")
        self.refresh_button.update_property([Gtk.AccessibleProperty.LABEL], ["Refresh"])
        self.refresh_button.connect("clicked", lambda *_: self.refresh())
        header.pack_start(self.refresh_button)

        menu = Gio.Menu()
        menu.append("Settings", "win.settings")
        menu.append("Remote and folder", "win.remote")
        menu.append("Keys and recovery", "win.keys")
        menu.append("Refresh", "win.refresh")
        menu.append("Help and shortcuts", "win.help")
        menu.append("About Timecrate", "win.about")
        menu_button = Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu)
        menu_button.set_tooltip_text("Main menu")
        menu_button.update_property([Gtk.AccessibleProperty.LABEL], ["Main menu"])
        header.pack_end(menu_button)

        self.header_spinner = Gtk.Spinner()
        header.pack_end(self.header_spinner)
        view.add_top_bar(header)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.banner = Adw.Banner()
        self.banner.set_revealed(False)
        box.append(self.banner)

        page = Adw.PreferencesPage()
        box.append(page)
        view.set_content(box)
        self.overlay.set_child(view)
        self.set_content(self.overlay)

        # Order matters: the backup list used to sit under Status AND "Encryption and key
        # safety", which put the thing people open this window to look at below the fold.
        self._build_status(page)
        self._build_actions(page)
        self._build_kits(page)
        self._build_checks(page)
        self._build_crypto(page)
        self._build_log(page)

        for name, fn in (("settings", self.open_settings), ("refresh", self.refresh),
                         ("keys", self.open_keys), ("remote", self.open_remote),
                         ("help", self.open_help), ("about", self.open_about)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda *_a, f=fn: f())
            self.add_action(action)
        app.set_accels_for_action("win.refresh", ["<Ctrl>r"])
        app.set_accels_for_action("win.settings", ["<Ctrl>comma"])

        # A privileged child is a root process holding a lock and, during a restore, writing to
        # disk. Closing the window would orphan it with nothing left watching its output.
        self.connect("close-request", self._on_close_request)
        self.refresh()

    # ---------- construction ----------

    def _install_css(self):
        # The pill colours are per-scheme and the CSS is reloaded when the scheme changes, because
        # GTK4 CSS has no prefers-color-scheme and one set of colours cannot serve both. The first
        # version had only the light set: on a dark desktop the status pills measured 1.36–1.61:1,
        # which is not "a bit low", it is invisible — the whole point of a pill being that you can
        # read the state at a glance. Every value below is measured, not chosen by eye, and
        # gui-smoke asserts the ratios so this cannot quietly regress.
        self._css_provider = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self._css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        manager = Adw.StyleManager.get_default()
        manager.connect("notify::dark", lambda *_: self._apply_css())
        self._apply_css()

    def _apply_css(self):
        dark = Adw.StyleManager.get_default().get_dark()
        # WCAG AA for normal text is 4.5:1. Measured against the resolved window background of
        # each scheme; see PILL_CONTRAST in hardening/gui-smoke.sh for the assertion.
        pills = PILL_DARK if dark else PILL_LIGHT
