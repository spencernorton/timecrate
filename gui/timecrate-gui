# systemd stores a calendar in its normalised form, so a timer set to `monthly` reads back as
# `*-*-01 00:00:00`. Without this the Schedule tab silently mis-reports what is configured —
# the same class of lie as a green "0 KITS".
CALENDAR_ALIASES = {
    "hourly": "*-*-* *:00:00",
    "daily": "*-*-* 00:00:00",
    "weekly": "Mon *-*-* 00:00:00",
    "monthly": "*-*-01 00:00:00",
    "yearly": "*-01-01 00:00:00",
    "annually": "*-01-01 00:00:00",
}


def same_calendar(a, b):
    a, b = a.strip(), b.strip()
    return CALENDAR_ALIASES.get(a, a) == CALENDAR_ALIASES.get(b, b)


def user_config_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(GLib.get_home_dir(), ".config")
    return os.path.join(base, "timecrate", "timecrate.conf")


def write_user_config(values):
    """Merge `values` into the per-user config, preserving whatever else is in it.

    The per-user file, not /etc: it needs no root, and the engine reads it at every entry point,
    because it resolves it from the account it is acting for rather than from $HOME.

    Which is why the pkexec resolution bug fixed in 2.6.0 reached here too: this window is
    unprivileged, so it wrote to the invoking user's home, while the engine it then called under
    pkexec resolved the account to root and read /root/.config instead. On a box that had not
    pinned TIMECRATE_USER, every setting changed in this dialog was silently ignored by every
    privileged operation. The root-run timers still need TIMECRATE_USER pinned to find this
    file — there is no invoking user for them to be inferred from.
    """
    path = user_config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except FileNotFoundError:
        lines = [
            "# Timecrate - per-user settings, written by the Timecrate settings window.",
            "# Overrides /etc/timecrate/timecrate.conf; the environment still wins over both.",
            "# `timecrate config` shows what is actually in effect.",
        ]

    for name, value in values.items():
        # shlex.quote because this file is sourced by the engine: an unquoted remote with a space
        # in it would be a syntax error that the next backup reports as something else entirely.
        entry = "%s=%s" % (name, shlex.quote(str(value)))
        pattern = re.compile(r"^\s*(?:export\s+)?%s=" % re.escape(name))
        for i, line in enumerate(lines):
            if pattern.match(line):
                lines[i] = entry
                break
        else:
            lines.append(entry)

    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines).rstrip() + "\n")
    os.replace(tmp, path)
    return path


def run_async(argv, on_done):
    """Run a command off the main loop. Calls on_done(ok, output).

    Everything this window renders comes through here. It used to be two blocking subprocess.run
    calls with 40-second timeouts, on the GTK main loop - so a slow remote froze the entire
    window for up to eighty seconds with no way to tell that from a crash.
    """
    try:
        proc = Gio.Subprocess.new(
            argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
    except GLib.Error as exc:
        GLib.idle_add(on_done, False, exc.message)
        return

    def finished(process, result):
        try:
            _ok, out, _err = process.communicate_utf8_finish(result)
            on_done(process.get_successful(), out or "")
        except GLib.Error as exc:
            on_done(False, exc.message)

    proc.communicate_utf8_async(None, None, finished)


class KitRow(Adw.ActionRow):
    def __init__(self, filename, display, on_restore, size="", deviation=None):
        if size not in ("", None):
            display = "%s  —  %s" % (display, human_bytes(size))
        super().__init__(title=display, subtitle=filename)
        self.filename = filename
        self.add_prefix(Gtk.Image.new_from_icon_name("document-save-symbolic"))

        # A kit that suddenly halves is the shape of an include set that quietly collapsed; one
        # that doubles is the shape of something bulky wandering in. Both pass every check the
        # engine makes -- the size rails only catch the extremes -- so the list says it out loud.
        self.deviation = deviation
        self.flagged = deviation is not None and abs(deviation) >= KIT_DEVIATION
        if self.flagged:
            mark = Gtk.Image.new_from_icon_name("dialog-warning-symbolic")
            mark.set_tooltip_text(
                "%+.0f%% versus the backup before it. Worth a look if nothing on this machine "
                "changed by that much." % (deviation * 100))
            mark.update_property([Gtk.AccessibleProperty.LABEL],
                                 ["Size changed %+.0f%% from the previous backup"
                                  % (deviation * 100)])
            self.add_suffix(mark)

        button = Gtk.Button(label="Restore…")
        button.set_valign(Gtk.Align.CENTER)
        button.add_css_class("suggested-action")
        button.update_property([Gtk.AccessibleProperty.LABEL],
                               ["Restore the backup from %s" % display])
        button.connect("clicked", lambda *_: on_restore(filename))
        self.restore_button = button
        self.add_suffix(button)

    def set_busy(self, busy):
        self.restore_button.set_sensitive(not busy)


