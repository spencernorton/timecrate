    def _open_full_log(self):
        # A terminal, not a pane in this window: it is a pager over a journal that can be long,
        # and the terminal already does paging, searching and following properly.
        # NOT --no-pager: journalctl would print and exit, and the terminal would close before
        # anyone read it. The pager is the whole reason for opening a terminal.
        for argv in (["gnome-terminal", "--", "journalctl", "-u", "timecrate-backup.service",
                      "-u", "timecrate-drill.service", "-n", "500", "-e"],
                     ["x-terminal-emulator", "-e",
                      "journalctl -u timecrate-backup.service -u timecrate-drill.service -e"]):
            try:
                Gio.Subprocess.new(argv, Gio.SubprocessFlags.NONE)
                return
            except GLib.Error:
                continue
        self.report("Could not open a terminal. Run:  journalctl -u timecrate-backup.service")

    def _on_history(self, ok, out):
        for row in self.history_rows:
            self.history_expander.remove(row)
        self.history_rows = []
        if not ok:
            return
        try:
            runs = json.loads(out)
        except ValueError:
            return
        if not runs:
            row = Adw.ActionRow(title="Nothing recorded yet")
            self.history_expander.add_row(row)
            self.history_rows.append(row)
            return
        for run in reversed(runs[-12:]):
            when = (run.get("when") or "")[:19].replace("T", " ")
            if run.get("kind") == "drill":
                result = run.get("result", "?")
                row = Adw.ActionRow(title="Recovery drill — %s" % result, subtitle=when)
                # by result, not unconditionally: a FAILED drill wearing a success icon is the
                # green-light-that-lies this window keeps having to be talked out of
                row.add_prefix(Gtk.Image.new_from_icon_name(
                    "emblem-ok-symbolic" if result == "PASSED" else "dialog-warning-symbolic"))
            else:
                # size and duration are absent on anything written before 1.9.0: say so rather
                # than render a confident 0 B
                size = human_bytes(run.get("bytes", ""))
                secs = run.get("seconds") or ""
                detail = "%s%s" % (size if run.get("bytes") else "size not recorded",
                                   " in %ss" % secs if secs else "")
                row = Adw.ActionRow(title="Backup — %s" % detail, subtitle=when)
                row.add_prefix(Gtk.Image.new_from_icon_name(
                    "document-save-symbolic" if run.get("result") == "ok"
                    else "dialog-warning-symbolic"))
            self.history_expander.add_row(row)
            self.history_rows.append(row)

